enable subgroups;
diagnostic(off, subgroup_uniformity);
// Generated by bigmont-core unrolledsq.rs: TPI 16, 10 limbs per lane, symmetric squaring then reduction.
const TPI: u32 = 16u;     // lanes per number
const LPL: u32 = 10u;     // limbs per lane; TPI * LPL = number of limbs
const L: u32 = TPI * LPL;
const WG: u32 = 64u;
const B: u32 = 13u;
const MASK: u32 = 0x1fffu;
const K: u32 = 6u;       // reduction owners between light carry passes (K * LPL <= 63 steps)

@group(0) @binding(0) var<uniform> params: vec4<u32>;          // x = instance count, y = ladder iterations in this dispatch, z MUST be 0 (ordering, see unrolledsq.rs)
@group(0) @binding(1) var<storage, read> n_limbs: array<u32>;
@group(0) @binding(2) var<storage, read> ninv_buf: array<u32>;
@group(0) @binding(3) var<storage, read_write> x_limbs: array<u32>;
@group(0) @binding(4) var<storage, read> e_words: array<u32>;   // n - 1, words per instance = fp.z
@group(0) @binding(5) var<uniform> fp: vec4<u32>;               // x = first iteration, y = nbits, z = words per instance

fn bcast(v: u32, src_lane: u32, base: u32) -> u32 { return subgroupShuffle(v, base + src_lane); }
fn down1(v: u32, lane: u32) -> u32 { return select(0u, subgroupShuffleDown(v, 1u), lane != TPI - 1u); }
fn up1(v: u32, lane: u32) -> u32 { return select(0u, subgroupShuffleUp(v, 1u), lane != 0u); }
fn any_nonzero(v: u32) -> bool { return subgroupAny(v != 0u); }

@compute @workgroup_size(WG)
fn main(@builtin(workgroup_id) wid: vec3<u32>, @builtin(local_invocation_index) li: u32, @builtin(subgroup_invocation_id) sg_in: u32) {
    let sg = sg_in;
    let lane = sg % TPI;
    let base = sg - lane;
    let inst = wid.x * (WG / TPI) + li / TPI;
    let live = inst < params.x;
    let ic = min(inst, params.x - 1u);     // out-of-range lanes compute on a valid instance; their store is skipped
    let off = ic * L + lane * LPL;
    var x0 = x_limbs[off + 0u];
    var x1 = x_limbs[off + 1u];
    var x2 = x_limbs[off + 2u];
    var x3 = x_limbs[off + 3u];
    var x4 = x_limbs[off + 4u];
    var x5 = x_limbs[off + 5u];
    var x6 = x_limbs[off + 6u];
    var x7 = x_limbs[off + 7u];
    var x8 = x_limbs[off + 8u];
    var x9 = x_limbs[off + 9u];
    let n0 = n_limbs[off];
    let ninv = ninv_buf[ic] & MASK;                   // already below 2^13; the explicit mask lets the compiler see the m product fits 24 bits
    let is0 = select(0u, 0xffffffffu, lane == 0u);   // all ones on lane 0 only
    let N0 = bcast(n0, 0u, base);                     // lane 0's limb 0 of n
    let NN0 = down1(n0, lane);                        // next lane's limb 0 of n (0 for the last lane)
    for (var s = 0u; s < params.y; s++) {
        let xp0 = x0 | (x1 << 16u);
        let xp1 = x2 | (x3 << 16u);
        let xp2 = x4 | (x5 << 16u);
        let xp3 = x6 | (x7 << 16u);
        let xp4 = x8 | (x9 << 16u);
        var lo0 = 0u;
        var hi0 = 0u;
        var lo1 = 0u;
        var hi1 = 0u;
        var lo2 = 0u;
        var hi2 = 0u;
        var lo3 = 0u;
        var hi3 = 0u;
        var lo4 = 0u;
        var hi4 = 0u;
        var lo5 = 0u;
        var hi5 = 0u;
        var lo6 = 0u;
        var hi6 = 0u;
        var lo7 = 0u;
        var hi7 = 0u;
        var lo8 = 0u;
        var hi8 = 0u;
        var lo9 = 0u;
        var hi9 = 0u;
        {
            let role = (lane + 0u) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 0u >= TPI;
            let pi = select(0u, role + 0u - 8u, wrap);       // block p of this lane's pair
            let qi = select(role + 0u, 8u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            let aw0 = bcast(xp0, pi, base);
            let aw1 = bcast(xp1, pi, base);
            let aw2 = bcast(xp2, pi, base);
            let aw3 = bcast(xp3, pi, base);
            let aw4 = bcast(xp4, pi, base);
            let ap0 = (aw0 & MASK);
            let ap1 = (aw0 >> 16u);
            let ap2 = (aw1 & MASK);
            let ap3 = (aw1 >> 16u);
            let ap4 = (aw2 & MASK);
            let ap5 = (aw2 >> 16u);
            let ap6 = (aw3 & MASK);
            let ap7 = (aw3 >> 16u);
            let ap8 = (aw4 & MASK);
            let ap9 = (aw4 >> 16u);
            var ph0 = 0u;
            var ph1 = 0u;
            var ph2 = 0u;
            var ph3 = 0u;
            var ph4 = 0u;
            var ph5 = 0u;
            var ph6 = 0u;
            var ph7 = 0u;
            var ph8 = 0u;
            var ph9 = 0u;
            let bw0 = xp0;
            {
                let bq = (bw0 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
                lo1 += ap1 * dj;
                lo2 += ap2 * dj;
                lo3 += ap3 * dj;
                lo4 += ap4 * dj;
                lo5 += ap5 * dj;
                lo6 += ap6 * dj;
                lo7 += ap7 * dj;
                lo8 += ap8 * dj;
                lo9 += ap9 * dj;
            }
            {
                let bq = (bw0 >> 16u);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 1 of D_q, below 2^14
                lo1 += ap0 * dj;
                lo2 += ap1 * dj;
                lo3 += ap2 * dj;
                lo4 += ap3 * dj;
                lo5 += ap4 * dj;
                lo6 += ap5 * dj;
                lo7 += ap6 * dj;
                lo8 += ap7 * dj;
                lo9 += ap8 * dj;
                ph0 += ap9 * dj;
            }
            let bw1 = xp1;
            {
                let bq = (bw1 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 2 of D_q, below 2^14
                lo2 += ap0 * dj;
                lo3 += ap1 * dj;
                lo4 += ap2 * dj;
                lo5 += ap3 * dj;
                lo6 += ap4 * dj;
                lo7 += ap5 * dj;
                lo8 += ap6 * dj;
                lo9 += ap7 * dj;
                ph0 += ap8 * dj;
                ph1 += ap9 * dj;
            }
            {
                let bq = (bw1 >> 16u);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 3 of D_q, below 2^14
                lo3 += ap0 * dj;
                lo4 += ap1 * dj;
                lo5 += ap2 * dj;
                lo6 += ap3 * dj;
                lo7 += ap4 * dj;
                lo8 += ap5 * dj;
                lo9 += ap6 * dj;
                ph0 += ap7 * dj;
                ph1 += ap8 * dj;
                ph2 += ap9 * dj;
            }
            let bw2 = xp2;
            {
                let bq = (bw2 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 4 of D_q, below 2^14
                lo4 += ap0 * dj;
                lo5 += ap1 * dj;
                lo6 += ap2 * dj;
                lo7 += ap3 * dj;
                lo8 += ap4 * dj;
                lo9 += ap5 * dj;
                ph0 += ap6 * dj;
                ph1 += ap7 * dj;
                ph2 += ap8 * dj;
                ph3 += ap9 * dj;
            }
            {
                let bq = (bw2 >> 16u);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 5 of D_q, below 2^14
                lo5 += ap0 * dj;
                lo6 += ap1 * dj;
                lo7 += ap2 * dj;
                lo8 += ap3 * dj;
                lo9 += ap4 * dj;
                ph0 += ap5 * dj;
                ph1 += ap6 * dj;
                ph2 += ap7 * dj;
                ph3 += ap8 * dj;
                ph4 += ap9 * dj;
            }
            let bw3 = xp3;
            {
                let bq = (bw3 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 6 of D_q, below 2^14
                lo6 += ap0 * dj;
                lo7 += ap1 * dj;
                lo8 += ap2 * dj;
                lo9 += ap3 * dj;
                ph0 += ap4 * dj;
                ph1 += ap5 * dj;
                ph2 += ap6 * dj;
                ph3 += ap7 * dj;
                ph4 += ap8 * dj;
                ph5 += ap9 * dj;
            }
            {
                let bq = (bw3 >> 16u);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 7 of D_q, below 2^14
                lo7 += ap0 * dj;
                lo8 += ap1 * dj;
                lo9 += ap2 * dj;
                ph0 += ap3 * dj;
                ph1 += ap4 * dj;
                ph2 += ap5 * dj;
                ph3 += ap6 * dj;
                ph4 += ap7 * dj;
                ph5 += ap8 * dj;
                ph6 += ap9 * dj;
            }
            let bw4 = xp4;
            {
                let bq = (bw4 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 8 of D_q, below 2^14
                lo8 += ap0 * dj;
                lo9 += ap1 * dj;
                ph0 += ap2 * dj;
                ph1 += ap3 * dj;
                ph2 += ap4 * dj;
                ph3 += ap5 * dj;
                ph4 += ap6 * dj;
                ph5 += ap7 * dj;
                ph6 += ap8 * dj;
                ph7 += ap9 * dj;
            }
            {
                let bq = (bw4 >> 16u);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 9 of D_q, below 2^14
                lo9 += ap0 * dj;
                ph0 += ap1 * dj;
                ph1 += ap2 * dj;
                ph2 += ap3 * dj;
                ph3 += ap4 * dj;
                ph4 += ap5 * dj;
                ph5 += ap6 * dj;
                ph6 += ap7 * dj;
                ph7 += ap8 * dj;
                ph8 += ap9 * dj;
            }
            // light pass over the block product: each word keeps its low 13 bits plus the carry of the word below; the top word keeps everything (bounds checked at generation)
            {
                let o0 = lo0;
                let o1 = lo1;
                let o2 = lo2;
                let o3 = lo3;
                let o4 = lo4;
                let o5 = lo5;
                let o6 = lo6;
                let o7 = lo7;
                let o8 = lo8;
                let o9 = lo9;
                let o10 = ph0;
                let o11 = ph1;
                let o12 = ph2;
                let o13 = ph3;
                let o14 = ph4;
                let o15 = ph5;
                let o16 = ph6;
                let o17 = ph7;
                let o18 = ph8;
                lo0 = (o0 & MASK);
                lo1 = (o1 & MASK) + (o0 >> B);
                lo2 = (o2 & MASK) + (o1 >> B);
                lo3 = (o3 & MASK) + (o2 >> B);
                lo4 = (o4 & MASK) + (o3 >> B);
                lo5 = (o5 & MASK) + (o4 >> B);
                lo6 = (o6 & MASK) + (o5 >> B);
                lo7 = (o7 & MASK) + (o6 >> B);
                lo8 = (o8 & MASK) + (o7 >> B);
                lo9 = (o9 & MASK) + (o8 >> B);
                ph0 = (o10 & MASK) + (o9 >> B);
                ph1 = (o11 & MASK) + (o10 >> B);
                ph2 = (o12 & MASK) + (o11 >> B);
                ph3 = (o13 & MASK) + (o12 >> B);
                ph4 = (o14 & MASK) + (o13 >> B);
                ph5 = (o15 & MASK) + (o14 >> B);
                ph6 = (o16 & MASK) + (o15 >> B);
                ph7 = (o17 & MASK) + (o16 >> B);
                ph8 = (o18 & MASK) + (o17 >> B);
                ph9 = ph9 + (o18 >> B);
            }
            let below = (lane + TPI - 1u) & (TPI - 1u);       // the lane whose high half lands here
            let to_hi = lane == 0u;
            { let v = bcast(ph0, below, base); lo0 += select(v, 0u, to_hi); hi0 += select(0u, v, to_hi); }
            { let v = bcast(ph1, below, base); lo1 += select(v, 0u, to_hi); hi1 += select(0u, v, to_hi); }
            { let v = bcast(ph2, below, base); lo2 += select(v, 0u, to_hi); hi2 += select(0u, v, to_hi); }
            { let v = bcast(ph3, below, base); lo3 += select(v, 0u, to_hi); hi3 += select(0u, v, to_hi); }
            { let v = bcast(ph4, below, base); lo4 += select(v, 0u, to_hi); hi4 += select(0u, v, to_hi); }
            { let v = bcast(ph5, below, base); lo5 += select(v, 0u, to_hi); hi5 += select(0u, v, to_hi); }
            { let v = bcast(ph6, below, base); lo6 += select(v, 0u, to_hi); hi6 += select(0u, v, to_hi); }
            { let v = bcast(ph7, below, base); lo7 += select(v, 0u, to_hi); hi7 += select(0u, v, to_hi); }
            { let v = bcast(ph8, below, base); lo8 += select(v, 0u, to_hi); hi8 += select(0u, v, to_hi); }
            { let v = bcast(ph9, below, base); lo9 += select(v, 0u, to_hi); hi9 += select(0u, v, to_hi); }
        }
        {
            let all = lo0 | hi0 | lo1 | hi1 | lo2 | hi2 | lo3 | hi3 | lo4 | hi4 | lo5 | hi5 | lo6 | hi6 | lo7 | hi7 | lo8 | hi8 | lo9 | hi9;
            let role = (lane + 14u + (all & params.z)) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 1u >= TPI;
            let pi = select(1u, role + 1u - 8u, wrap);       // block p of this lane's pair
            let qi = select(role + 1u, 9u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            // exchange lo and hi on these lanes, so that lo names the block that receives this lane's low half
            let sw = lane >= 0u && lane < 2u;
            { let a = select(lo0, hi0, sw); hi0 = select(hi0, lo0, sw); lo0 = a; }
            { let a = select(lo1, hi1, sw); hi1 = select(hi1, lo1, sw); lo1 = a; }
            { let a = select(lo2, hi2, sw); hi2 = select(hi2, lo2, sw); lo2 = a; }
            { let a = select(lo3, hi3, sw); hi3 = select(hi3, lo3, sw); lo3 = a; }
            { let a = select(lo4, hi4, sw); hi4 = select(hi4, lo4, sw); lo4 = a; }
            { let a = select(lo5, hi5, sw); hi5 = select(hi5, lo5, sw); lo5 = a; }
            { let a = select(lo6, hi6, sw); hi6 = select(hi6, lo6, sw); lo6 = a; }
            { let a = select(lo7, hi7, sw); hi7 = select(hi7, lo7, sw); lo7 = a; }
            { let a = select(lo8, hi8, sw); hi8 = select(hi8, lo8, sw); lo8 = a; }
            { let a = select(lo9, hi9, sw); hi9 = select(hi9, lo9, sw); lo9 = a; }
            let aw0 = bcast(xp0, pi, base);
            let aw1 = bcast(xp1, pi, base);
            let aw2 = bcast(xp2, pi, base);
            let aw3 = bcast(xp3, pi, base);
            let aw4 = bcast(xp4, pi, base);
            let ap0 = (aw0 & MASK);
            let ap1 = (aw0 >> 16u);
            let ap2 = (aw1 & MASK);
            let ap3 = (aw1 >> 16u);
            let ap4 = (aw2 & MASK);
            let ap5 = (aw2 >> 16u);
            let ap6 = (aw3 & MASK);
            let ap7 = (aw3 >> 16u);
            let ap8 = (aw4 & MASK);
            let ap9 = (aw4 >> 16u);
            var ph0 = 0u;
            var ph1 = 0u;
            var ph2 = 0u;
            var ph3 = 0u;
            var ph4 = 0u;
            var ph5 = 0u;
            var ph6 = 0u;
            var ph7 = 0u;
            var ph8 = 0u;
            var ph9 = 0u;
            let bw0 = bcast(xp0, qi, base);
            {
                let bq = (bw0 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
                lo1 += ap1 * dj;
                lo2 += ap2 * dj;
                lo3 += ap3 * dj;
                lo4 += ap4 * dj;
                lo5 += ap5 * dj;
                lo6 += ap6 * dj;
                lo7 += ap7 * dj;
                lo8 += ap8 * dj;
                lo9 += ap9 * dj;
            }
            {
                let bq = (bw0 >> 16u);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 1 of D_q, below 2^14
                lo1 += ap0 * dj;
                lo2 += ap1 * dj;
                lo3 += ap2 * dj;
                lo4 += ap3 * dj;
                lo5 += ap4 * dj;
                lo6 += ap5 * dj;
                lo7 += ap6 * dj;
                lo8 += ap7 * dj;
                lo9 += ap8 * dj;
                ph0 += ap9 * dj;
            }
            let bw1 = bcast(xp1, qi, base);
            {
                let bq = (bw1 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 2 of D_q, below 2^14
                lo2 += ap0 * dj;
                lo3 += ap1 * dj;
                lo4 += ap2 * dj;
                lo5 += ap3 * dj;
                lo6 += ap4 * dj;
                lo7 += ap5 * dj;
                lo8 += ap6 * dj;
                lo9 += ap7 * dj;
                ph0 += ap8 * dj;
                ph1 += ap9 * dj;
            }
            {
                let bq = (bw1 >> 16u);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 3 of D_q, below 2^14
                lo3 += ap0 * dj;
                lo4 += ap1 * dj;
                lo5 += ap2 * dj;
                lo6 += ap3 * dj;
                lo7 += ap4 * dj;
                lo8 += ap5 * dj;
                lo9 += ap6 * dj;
                ph0 += ap7 * dj;
                ph1 += ap8 * dj;
                ph2 += ap9 * dj;
            }
            let bw2 = bcast(xp2, qi, base);
            {
                let bq = (bw2 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 4 of D_q, below 2^14
                lo4 += ap0 * dj;
                lo5 += ap1 * dj;
                lo6 += ap2 * dj;
                lo7 += ap3 * dj;
                lo8 += ap4 * dj;
                lo9 += ap5 * dj;
                ph0 += ap6 * dj;
                ph1 += ap7 * dj;
                ph2 += ap8 * dj;
                ph3 += ap9 * dj;
            }
            {
                let bq = (bw2 >> 16u);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 5 of D_q, below 2^14
                lo5 += ap0 * dj;
                lo6 += ap1 * dj;
                lo7 += ap2 * dj;
                lo8 += ap3 * dj;
                lo9 += ap4 * dj;
                ph0 += ap5 * dj;
                ph1 += ap6 * dj;
                ph2 += ap7 * dj;
                ph3 += ap8 * dj;
                ph4 += ap9 * dj;
            }
            let bw3 = bcast(xp3, qi, base);
            {
                let bq = (bw3 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 6 of D_q, below 2^14
                lo6 += ap0 * dj;
                lo7 += ap1 * dj;
                lo8 += ap2 * dj;
                lo9 += ap3 * dj;
                ph0 += ap4 * dj;
                ph1 += ap5 * dj;
                ph2 += ap6 * dj;
                ph3 += ap7 * dj;
                ph4 += ap8 * dj;
                ph5 += ap9 * dj;
            }
            {
                let bq = (bw3 >> 16u);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 7 of D_q, below 2^14
                lo7 += ap0 * dj;
                lo8 += ap1 * dj;
                lo9 += ap2 * dj;
                ph0 += ap3 * dj;
                ph1 += ap4 * dj;
                ph2 += ap5 * dj;
                ph3 += ap6 * dj;
                ph4 += ap7 * dj;
                ph5 += ap8 * dj;
                ph6 += ap9 * dj;
            }
            let bw4 = bcast(xp4, qi, base);
            {
                let bq = (bw4 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 8 of D_q, below 2^14
                lo8 += ap0 * dj;
                lo9 += ap1 * dj;
                ph0 += ap2 * dj;
                ph1 += ap3 * dj;
                ph2 += ap4 * dj;
                ph3 += ap5 * dj;
                ph4 += ap6 * dj;
                ph5 += ap7 * dj;
                ph6 += ap8 * dj;
                ph7 += ap9 * dj;
            }
            {
                let bq = (bw4 >> 16u);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 9 of D_q, below 2^14
                lo9 += ap0 * dj;
                ph0 += ap1 * dj;
                ph1 += ap2 * dj;
                ph2 += ap3 * dj;
                ph3 += ap4 * dj;
                ph4 += ap5 * dj;
                ph5 += ap6 * dj;
                ph6 += ap7 * dj;
                ph7 += ap8 * dj;
                ph8 += ap9 * dj;
            }
            // light pass over the block product: each word keeps its low 13 bits plus the carry of the word below; the top word keeps everything (bounds checked at generation)
            {
                let o0 = lo0;
                let o1 = lo1;
                let o2 = lo2;
                let o3 = lo3;
                let o4 = lo4;
                let o5 = lo5;
                let o6 = lo6;
                let o7 = lo7;
                let o8 = lo8;
                let o9 = lo9;
                let o10 = ph0;
                let o11 = ph1;
                let o12 = ph2;
                let o13 = ph3;
                let o14 = ph4;
                let o15 = ph5;
                let o16 = ph6;
                let o17 = ph7;
                let o18 = ph8;
                lo0 = (o0 & MASK);
                lo1 = (o1 & MASK) + (o0 >> B);
                lo2 = (o2 & MASK) + (o1 >> B);
                lo3 = (o3 & MASK) + (o2 >> B);
                lo4 = (o4 & MASK) + (o3 >> B);
                lo5 = (o5 & MASK) + (o4 >> B);
                lo6 = (o6 & MASK) + (o5 >> B);
                lo7 = (o7 & MASK) + (o6 >> B);
                lo8 = (o8 & MASK) + (o7 >> B);
                lo9 = (o9 & MASK) + (o8 >> B);
                ph0 = (o10 & MASK) + (o9 >> B);
                ph1 = (o11 & MASK) + (o10 >> B);
