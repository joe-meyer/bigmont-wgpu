                let v4 = t4;
                t4 = (v4 & MASK) + c_in;
                c_in = v4 >> B;
                let v5 = t5;
                t5 = (v5 & MASK) + c_in;
                c_in = v5 >> B;
                let v6 = t6;
                t6 = (v6 & MASK) + c_in;
                c_in = v6 >> B;
                let v7 = t7;
                t7 = (v7 & MASK) + c_in;
                c_in = v7 >> B;
                let v8 = t8;
                t8 = (v8 & MASK) + c_in;
                c_in = v8 >> B;
                let v9 = t9;
                t9 = (v9 & MASK) + c_in;
                c_in = v9 >> B;
            }
        }
        x0 = t0;
        x1 = t1;
        x2 = t2;
        x3 = t3;
        x4 = t4;
        x5 = t5;
        x6 = t6;
        x7 = t7;
        x8 = t8;
        x9 = t9;
        let gi = fp.y - 2u - (fp.x + s);
        let ebit = (e_words[ic * fp.z + (gi >> 5u)] >> (gi & 31u)) & 1u;
        t0 = x0 << 1u;
        t1 = x1 << 1u;
        t2 = x2 << 1u;
        t3 = x3 << 1u;
        t4 = x4 << 1u;
        t5 = x5 << 1u;
        t6 = x6 << 1u;
        t7 = x7 << 1u;
        t8 = x8 << 1u;
        t9 = x9 << 1u;
        for (var round = 0u; round < L + 2u; round++) {
            let big = (t0 >> B) | (t1 >> B) | (t2 >> B) | (t3 >> B) | (t4 >> B) | (t5 >> B) | (t6 >> B) | (t7 >> B) | (t8 >> B) | (t9 >> B);
            if (!any_nonzero(big)) { break; }
            {
                var c_in = up1(t9 >> B, lane);   // read before any limb is modified
                let v0 = t0;
                t0 = (v0 & MASK) + c_in;
                c_in = v0 >> B;
                let v1 = t1;
                t1 = (v1 & MASK) + c_in;
                c_in = v1 >> B;
                let v2 = t2;
                t2 = (v2 & MASK) + c_in;
                c_in = v2 >> B;
                let v3 = t3;
                t3 = (v3 & MASK) + c_in;
                c_in = v3 >> B;
                let v4 = t4;
                t4 = (v4 & MASK) + c_in;
                c_in = v4 >> B;
                let v5 = t5;
                t5 = (v5 & MASK) + c_in;
                c_in = v5 >> B;
                let v6 = t6;
                t6 = (v6 & MASK) + c_in;
                c_in = v6 >> B;
                let v7 = t7;
                t7 = (v7 & MASK) + c_in;
                c_in = v7 >> B;
                let v8 = t8;
                t8 = (v8 & MASK) + c_in;
                c_in = v8 >> B;
                let v9 = t9;
                t9 = (v9 & MASK) + c_in;
                c_in = v9 >> B;
            }
        }
        x0 = select(x0, t0, ebit == 1u);
        x1 = select(x1, t1, ebit == 1u);
        x2 = select(x2, t2, ebit == 1u);
        x3 = select(x3, t3, ebit == 1u);
        x4 = select(x4, t4, ebit == 1u);
        x5 = select(x5, t5, ebit == 1u);
        x6 = select(x6, t6, ebit == 1u);
        x7 = select(x7, t7, ebit == 1u);
        x8 = select(x8, t8, ebit == 1u);
        x9 = select(x9, t9, ebit == 1u);
    }
    if (live) {
        x_limbs[off + 0u] = x0;
        x_limbs[off + 1u] = x1;
        x_limbs[off + 2u] = x2;
        x_limbs[off + 3u] = x3;
        x_limbs[off + 4u] = x4;
        x_limbs[off + 5u] = x5;
        x_limbs[off + 6u] = x6;
        x_limbs[off + 7u] = x7;
        x_limbs[off + 8u] = x8;
        x_limbs[off + 9u] = x9;
    }
}
