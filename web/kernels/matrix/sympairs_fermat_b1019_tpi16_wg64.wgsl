            hi3 += select(pw3, pw8, odd);
            hi4 += select(pw4, pw9, odd);
        }
        let n1 = n_limbs[off + 1u];
        let n2 = n_limbs[off + 2u];
        let n3 = n_limbs[off + 3u];
        let n4 = n_limbs[off + 4u];
        var t0 = lo0;
        var t1 = lo1;
        var t2 = lo2;
        var t3 = lo3;
        var t4 = lo4;
        for (var owner = 0u; owner < TPI; owner++) {
            {
                let T0 = bcast(t0, 0u, base);               // window limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's window limb 0 (0 for the last lane)
                let m = ((T0 & MASK) * ninv) & MASK;        // Montgomery factor: only the low 13 bits matter (24-bit multiply)
                let carry0 = (T0 + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                t0 = t1 + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (n2 & 0xffffffu) * m;
                t2 = t3 + (n3 & 0xffffffu) * m;
                t3 = t4 + (n4 & 0xffffffu) * m;
                t4 = TN + (NN0 & 0xffffffu) * m;
            }
            {
                let T0 = bcast(t0, 0u, base);               // window limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's window limb 0 (0 for the last lane)
                let m = ((T0 & MASK) * ninv) & MASK;        // Montgomery factor: only the low 13 bits matter (24-bit multiply)
                let carry0 = (T0 + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                t0 = t1 + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (n2 & 0xffffffu) * m;
                t2 = t3 + (n3 & 0xffffffu) * m;
                t3 = t4 + (n4 & 0xffffffu) * m;
                t4 = TN + (NN0 & 0xffffffu) * m;
            }
            {
                let T0 = bcast(t0, 0u, base);               // window limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's window limb 0 (0 for the last lane)
                let m = ((T0 & MASK) * ninv) & MASK;        // Montgomery factor: only the low 13 bits matter (24-bit multiply)
                let carry0 = (T0 + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                t0 = t1 + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (n2 & 0xffffffu) * m;
                t2 = t3 + (n3 & 0xffffffu) * m;
                t3 = t4 + (n4 & 0xffffffu) * m;
                t4 = TN + (NN0 & 0xffffffu) * m;
            }
            {
                let T0 = bcast(t0, 0u, base);               // window limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's window limb 0 (0 for the last lane)
                let m = ((T0 & MASK) * ninv) & MASK;        // Montgomery factor: only the low 13 bits matter (24-bit multiply)
                let carry0 = (T0 + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                t0 = t1 + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (n2 & 0xffffffu) * m;
                t2 = t3 + (n3 & 0xffffffu) * m;
                t3 = t4 + (n4 & 0xffffffu) * m;
                t4 = TN + (NN0 & 0xffffffu) * m;
            }
            {
                let T0 = bcast(t0, 0u, base);               // window limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's window limb 0 (0 for the last lane)
                let m = ((T0 & MASK) * ninv) & MASK;        // Montgomery factor: only the low 13 bits matter (24-bit multiply)
                let carry0 = (T0 + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                t0 = t1 + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (n2 & 0xffffffu) * m;
                t2 = t3 + (n3 & 0xffffffu) * m;
                t3 = t4 + (n4 & 0xffffffu) * m;
                t4 = TN + (NN0 & 0xffffffu) * m;
            }
            if ((owner % K) == K - 1u) {
                {
                    var c_in = up1(t4 >> B, lane);   // read before any limb is modified
                    let v0 = t0;
                    t0 = (v0 & MASK) + c_in;
                    c_in = v0 >> B;
                    let v1 = t1;
                    t1 = (v1 & MASK) + c_in;
                    c_in = v1 >> B;
                    let v2 = t2;
                    t2 = (v2 & MASK) + c_in;
                    c_in = v2 >> B;
                    let v3 = t3;
                    t3 = (v3 & MASK) + c_in;
                    c_in = v3 >> B;
                    let v4 = t4;
                    t4 = (v4 & MASK) + c_in;
                    c_in = v4 >> B;
                }
            }
        }
        // + S_hi: lane j's block TPI + j of x^2 has the weight of the result's block j
        t0 += hi0;
        t1 += hi1;
        t2 += hi2;
        t3 += hi3;
        t4 += hi4;
        for (var round = 0u; round < L + 2u; round++) {
            let big = (t0 >> B) | (t1 >> B) | (t2 >> B) | (t3 >> B) | (t4 >> B);
            if (!any_nonzero(big)) { break; }
            {
                var c_in = up1(t4 >> B, lane);   // read before any limb is modified
                let v0 = t0;
                t0 = (v0 & MASK) + c_in;
                c_in = v0 >> B;
                let v1 = t1;
                t1 = (v1 & MASK) + c_in;
                c_in = v1 >> B;
                let v2 = t2;
                t2 = (v2 & MASK) + c_in;
                c_in = v2 >> B;
                let v3 = t3;
                t3 = (v3 & MASK) + c_in;
                c_in = v3 >> B;
                let v4 = t4;
                t4 = (v4 & MASK) + c_in;
                c_in = v4 >> B;
            }
        }
        x0 = t0;
        x1 = t1;
        x2 = t2;
        x3 = t3;
        x4 = t4;
        let gi = fp.y - 2u - (fp.x + s);
        let ebit = (e_words[ic * fp.z + (gi >> 5u)] >> (gi & 31u)) & 1u;
        t0 = x0 << 1u;
        t1 = x1 << 1u;
        t2 = x2 << 1u;
        t3 = x3 << 1u;
        t4 = x4 << 1u;
        for (var round = 0u; round < L + 2u; round++) {
            let big = (t0 >> B) | (t1 >> B) | (t2 >> B) | (t3 >> B) | (t4 >> B);
            if (!any_nonzero(big)) { break; }
            {
                var c_in = up1(t4 >> B, lane);   // read before any limb is modified
                let v0 = t0;
                t0 = (v0 & MASK) + c_in;
                c_in = v0 >> B;
                let v1 = t1;
                t1 = (v1 & MASK) + c_in;
                c_in = v1 >> B;
                let v2 = t2;
                t2 = (v2 & MASK) + c_in;
                c_in = v2 >> B;
                let v3 = t3;
                t3 = (v3 & MASK) + c_in;
                c_in = v3 >> B;
                let v4 = t4;
                t4 = (v4 & MASK) + c_in;
                c_in = v4 >> B;
            }
        }
        x0 = select(x0, t0, ebit == 1u);
        x1 = select(x1, t1, ebit == 1u);
        x2 = select(x2, t2, ebit == 1u);
        x3 = select(x3, t3, ebit == 1u);
        x4 = select(x4, t4, ebit == 1u);
    }
    if (live) {
        x_limbs[off + 0u] = x0;
        x_limbs[off + 1u] = x1;
        x_limbs[off + 2u] = x2;
        x_limbs[off + 3u] = x3;
        x_limbs[off + 4u] = x4;
    }
}
