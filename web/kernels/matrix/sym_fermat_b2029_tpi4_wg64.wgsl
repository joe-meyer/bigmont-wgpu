    var x20 = x_limbs[off + 20u];
    var x21 = x_limbs[off + 21u];
    var x22 = x_limbs[off + 22u];
    var x23 = x_limbs[off + 23u];
    var x24 = x_limbs[off + 24u];
    var x25 = x_limbs[off + 25u];
    var x26 = x_limbs[off + 26u];
    var x27 = x_limbs[off + 27u];
    var x28 = x_limbs[off + 28u];
    var x29 = x_limbs[off + 29u];
    var x30 = x_limbs[off + 30u];
    var x31 = x_limbs[off + 31u];
