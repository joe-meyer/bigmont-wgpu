enable subgroups;
diagnostic(off, subgroup_uniformity);
// Generated by bigmont-core unrolledsq.rs: TPI 16, 1 limbs per lane, symmetric squaring then reduction.
const TPI: u32 = 16u;     // lanes per number
const LPL: u32 = 1u;     // limbs per lane; TPI * LPL = number of limbs
const L: u32 = TPI * LPL;
const WG: u32 = 64u;
const B: u32 = 13u;
const MASK: u32 = 0x1fffu;
const K: u32 = 63u;       // reduction owners between light carry passes (K * LPL <= 63 steps)

@group(0) @binding(0) var<uniform> params: vec4<u32>;          // x = instance count, y = ladder iterations in this dispatch
@group(0) @binding(1) var<storage, read> n_limbs: array<u32>;
@group(0) @binding(2) var<storage, read> ninv_buf: array<u32>;
@group(0) @binding(3) var<storage, read_write> x_limbs: array<u32>;
@group(0) @binding(4) var<storage, read> e_words: array<u32>;   // n - 1, words per instance = fp.z
@group(0) @binding(5) var<uniform> fp: vec4<u32>;               // x = first iteration, y = nbits, z = words per instance

fn bcast(v: u32, src_lane: u32, base: u32) -> u32 { return subgroupShuffle(v, base + src_lane); }
fn down1(v: u32, lane: u32) -> u32 { return select(0u, subgroupShuffleDown(v, 1u), lane != TPI - 1u); }
fn up1(v: u32, lane: u32) -> u32 { return select(0u, subgroupShuffleUp(v, 1u), lane != 0u); }
fn any_nonzero(v: u32) -> bool { return subgroupAny(v != 0u); }

@compute @workgroup_size(WG)
fn main(@builtin(workgroup_id) wid: vec3<u32>, @builtin(local_invocation_index) li: u32, @builtin(subgroup_invocation_id) sg_in: u32) {
    let sg = sg_in;
    let lane = sg % TPI;
    let base = sg - lane;
    let inst = wid.x * (WG / TPI) + li / TPI;
    let live = inst < params.x;
    let ic = min(inst, params.x - 1u);     // out-of-range lanes compute on a valid instance; their store is skipped
    let off = ic * L + lane * LPL;
    var x0 = x_limbs[off + 0u];
    let n0 = n_limbs[off];
    let ninv = ninv_buf[ic] & MASK;                   // already below 2^13; the explicit mask lets the compiler see the m product fits 24 bits
    let is0 = select(0u, 0xffffffffu, lane == 0u);   // all ones on lane 0 only
    let N0 = bcast(n0, 0u, base);                     // lane 0's limb 0 of n
    let NN0 = down1(n0, lane);                        // next lane's limb 0 of n (0 for the last lane)
    for (var s = 0u; s < params.y; s++) {
        let xp0 = x0;
        var lo0 = 0u;
        var hi0 = 0u;
        {
            let role = (lane + 0u) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 0u >= TPI;
            let pi = select(0u, role + 0u - 8u, wrap);       // block p of this lane's pair
            let qi = select(role + 0u, 8u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            let aw0 = bcast(xp0, pi, base);
            let ap0 = (aw0 & MASK);
            var ph0 = 0u;
            let bw0 = xp0;
            {
                let bq = (bw0 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
            }
            {
                let o0 = lo0;
                lo0 = (o0 & MASK);
                ph0 = ph0 + (o0 >> B);
            }
            let below = (lane + TPI - 1u) & (TPI - 1u);       // the lane whose high half lands here
            let to_hi = lane == 0u;
            { let v = bcast(ph0, below, base); lo0 += select(v, 0u, to_hi); hi0 += select(0u, v, to_hi); }
        }
        {
            let all = lo0 | hi0;
            let role = (lane + 14u + (all & params.z)) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 1u >= TPI;
            let pi = select(1u, role + 1u - 8u, wrap);       // block p of this lane's pair
            let qi = select(role + 1u, 9u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            let sw = lane >= 0u && lane < 2u;
            { let a = select(lo0, hi0, sw); hi0 = select(hi0, lo0, sw); lo0 = a; }
            let aw0 = bcast(xp0, pi, base);
            let ap0 = (aw0 & MASK);
            var ph0 = 0u;
            let bw0 = bcast(xp0, qi, base);
            {
                let bq = (bw0 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
            }
            {
                let o0 = lo0;
                lo0 = (o0 & MASK);
                ph0 = ph0 + (o0 >> B);
            }
            let below = (lane + TPI - 1u) & (TPI - 1u);       // the lane whose high half lands here
            let to_hi = lane == 2u;
            { let v = bcast(ph0, below, base); lo0 += select(v, 0u, to_hi); hi0 += select(0u, v, to_hi); }
        }
        {
            let all = lo0 | hi0;
            let role = (lane + 12u + (all & params.z)) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 2u >= TPI;
            let pi = select(2u, role + 2u - 8u, wrap);       // block p of this lane's pair
            let qi = select(role + 2u, 10u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            let sw = lane >= 2u && lane < 4u;
            { let a = select(lo0, hi0, sw); hi0 = select(hi0, lo0, sw); lo0 = a; }
            let aw0 = bcast(xp0, pi, base);
            let ap0 = (aw0 & MASK);
            var ph0 = 0u;
            let bw0 = bcast(xp0, qi, base);
            {
                let bq = (bw0 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
            }
            {
                let o0 = lo0;
                lo0 = (o0 & MASK);
                ph0 = ph0 + (o0 >> B);
            }
            let below = (lane + TPI - 1u) & (TPI - 1u);       // the lane whose high half lands here
            let to_hi = lane == 4u;
            { let v = bcast(ph0, below, base); lo0 += select(v, 0u, to_hi); hi0 += select(0u, v, to_hi); }
        }
        {
            let all = lo0 | hi0;
            let role = (lane + 10u + (all & params.z)) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 3u >= TPI;
            let pi = select(3u, role + 3u - 8u, wrap);       // block p of this lane's pair
            let qi = select(role + 3u, 11u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            let sw = lane >= 4u && lane < 6u;
            { let a = select(lo0, hi0, sw); hi0 = select(hi0, lo0, sw); lo0 = a; }
            let aw0 = bcast(xp0, pi, base);
            let ap0 = (aw0 & MASK);
            var ph0 = 0u;
            let bw0 = bcast(xp0, qi, base);
            {
                let bq = (bw0 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
            }
            {
                let o0 = lo0;
                lo0 = (o0 & MASK);
                ph0 = ph0 + (o0 >> B);
            }
            let below = (lane + TPI - 1u) & (TPI - 1u);       // the lane whose high half lands here
            let to_hi = lane == 6u;
            { let v = bcast(ph0, below, base); lo0 += select(v, 0u, to_hi); hi0 += select(0u, v, to_hi); }
        }
        {
            let all = lo0 | hi0;
            let role = (lane + 8u + (all & params.z)) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 4u >= TPI;
            let pi = select(4u, role + 4u - 8u, wrap);       // block p of this lane's pair
            let qi = select(role + 4u, 12u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            let sw = lane >= 6u && lane < 8u;
            { let a = select(lo0, hi0, sw); hi0 = select(hi0, lo0, sw); lo0 = a; }
            let aw0 = bcast(xp0, pi, base);
            let ap0 = (aw0 & MASK);
            var ph0 = 0u;
            let bw0 = bcast(xp0, qi, base);
            {
                let bq = (bw0 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
            }
            {
                let o0 = lo0;
                lo0 = (o0 & MASK);
                ph0 = ph0 + (o0 >> B);
            }
            let below = (lane + TPI - 1u) & (TPI - 1u);       // the lane whose high half lands here
            let to_hi = lane == 8u;
            { let v = bcast(ph0, below, base); lo0 += select(v, 0u, to_hi); hi0 += select(0u, v, to_hi); }
        }
        {
            let all = lo0 | hi0;
            let role = (lane + 6u + (all & params.z)) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 5u >= TPI;
            let pi = select(5u, role + 5u - 8u, wrap);       // block p of this lane's pair
            let qi = select(role + 5u, 13u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            let sw = lane >= 8u && lane < 10u;
            { let a = select(lo0, hi0, sw); hi0 = select(hi0, lo0, sw); lo0 = a; }
            let aw0 = bcast(xp0, pi, base);
            let ap0 = (aw0 & MASK);
            var ph0 = 0u;
            let bw0 = bcast(xp0, qi, base);
            {
                let bq = (bw0 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
            }
            {
                let o0 = lo0;
                lo0 = (o0 & MASK);
                ph0 = ph0 + (o0 >> B);
            }
            let below = (lane + TPI - 1u) & (TPI - 1u);       // the lane whose high half lands here
            let to_hi = lane == 10u;
            { let v = bcast(ph0, below, base); lo0 += select(v, 0u, to_hi); hi0 += select(0u, v, to_hi); }
        }
        {
            let all = lo0 | hi0;
            let role = (lane + 4u + (all & params.z)) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 6u >= TPI;
            let pi = select(6u, role + 6u - 8u, wrap);       // block p of this lane's pair
            let qi = select(role + 6u, 14u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            let sw = lane >= 10u && lane < 12u;
            { let a = select(lo0, hi0, sw); hi0 = select(hi0, lo0, sw); lo0 = a; }
            let aw0 = bcast(xp0, pi, base);
            let ap0 = (aw0 & MASK);
            var ph0 = 0u;
            let bw0 = bcast(xp0, qi, base);
            {
                let bq = (bw0 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
            }
            {
                let o0 = lo0;
                lo0 = (o0 & MASK);
                ph0 = ph0 + (o0 >> B);
            }
            let below = (lane + TPI - 1u) & (TPI - 1u);       // the lane whose high half lands here
            let to_hi = lane == 12u;
            { let v = bcast(ph0, below, base); lo0 += select(v, 0u, to_hi); hi0 += select(0u, v, to_hi); }
        }
        {
            let all = lo0 | hi0;
            let role = (lane + 2u + (all & params.z)) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 7u >= TPI;
            let pi = select(7u, role + 7u - 8u, wrap);       // block p of this lane's pair
            let qi = select(role + 7u, 15u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            let sw = lane >= 12u && lane < 14u;
            { let a = select(lo0, hi0, sw); hi0 = select(hi0, lo0, sw); lo0 = a; }
            let aw0 = bcast(xp0, pi, base);
            let ap0 = (aw0 & MASK);
            var ph0 = 0u;
            let bw0 = bcast(xp0, qi, base);
            {
                let bq = (bw0 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
            }
            {
                let o0 = lo0;
                lo0 = (o0 & MASK);
                ph0 = ph0 + (o0 >> B);
            }
            let below = (lane + TPI - 1u) & (TPI - 1u);       // the lane whose high half lands here
            let to_hi = lane == 14u;
            { let v = bcast(ph0, below, base); lo0 += select(v, 0u, to_hi); hi0 += select(0u, v, to_hi); }
        }
        let sw = lane < 14u;
        { let a = select(lo0, hi0, sw); hi0 = select(hi0, lo0, sw); lo0 = a; }
        {
            let all = lo0 | hi0;
            let ai = 8u + (lane >> 1u) + (all & params.z);
            let dw0 = bcast(xp0, ai, base);
            let dg0 = (dw0 & MASK);
            var pw0 = 0u;
            var pw1 = 0u;
            {
                pw0 += dg0 * dg0;
            }
            {
                let o0 = pw0;
                pw0 = (o0 & MASK);
                pw1 = pw1 + (o0 >> B);
            }
            let odd = (lane & 1u) == 1u;
            hi0 += select(pw0, pw1, odd);
        }
        var t0 = lo0;
        for (var owner = 0u; owner < TPI; owner++) {
            {
                let T0 = bcast(t0, 0u, base);               // window limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's window limb 0 (0 for the last lane)
                let m = ((T0 & MASK) * ninv) & MASK;        // Montgomery factor: only the low 13 bits matter (24-bit multiply)
                let carry0 = (T0 + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                t0 = TN + (NN0 & 0xffffffu) * m + (carry0 & is0);
            }
            if ((owner % K) == K - 1u) {
                {
                    var c_in = up1(t0 >> B, lane);   // read before any limb is modified
                    let v0 = t0;
                    t0 = (v0 & MASK) + c_in;
                    c_in = v0 >> B;
                }
            }
        }
        // + S_hi: lane j's block TPI + j of x^2 has the weight of the result's block j
        t0 += hi0;
        for (var round = 0u; round < L + 2u; round++) {
            let big = (t0 >> B);
            if (!any_nonzero(big)) { break; }
            {
                var c_in = up1(t0 >> B, lane);   // read before any limb is modified
                let v0 = t0;
                t0 = (v0 & MASK) + c_in;
                c_in = v0 >> B;
            }
        }
        x0 = t0;
        let gi = fp.y - 2u - (fp.x + s);
        let ebit = (e_words[ic * fp.z + (gi >> 5u)] >> (gi & 31u)) & 1u;
        t0 = x0 << 1u;
        for (var round = 0u; round < L + 2u; round++) {
            let big = (t0 >> B);
            if (!any_nonzero(big)) { break; }
            {
                var c_in = up1(t0 >> B, lane);   // read before any limb is modified
                let v0 = t0;
                t0 = (v0 & MASK) + c_in;
                c_in = v0 >> B;
            }
        }
        x0 = select(x0, t0, ebit == 1u);
    }
    if (live) {
        x_limbs[off + 0u] = x0;
    }
}
