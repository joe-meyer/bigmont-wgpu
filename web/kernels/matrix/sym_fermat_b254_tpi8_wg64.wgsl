enable subgroups;
diagnostic(off, subgroup_uniformity);
// Generated by bigmont-core unrolledsq.rs: TPI 8, 3 limbs per lane, symmetric squaring then reduction.
const TPI: u32 = 8u;     // lanes per number
const LPL: u32 = 3u;     // limbs per lane; TPI * LPL = number of limbs
const L: u32 = TPI * LPL;
const WG: u32 = 64u;
const B: u32 = 13u;
const MASK: u32 = 0x1fffu;
const K: u32 = 21u;       // reduction owners between light carry passes (K * LPL <= 63 steps)

@group(0) @binding(0) var<uniform> params: vec4<u32>;          // x = instance count, y = ladder iterations in this dispatch, z MUST be 0 (ordering, see unrolledsq.rs)
@group(0) @binding(1) var<storage, read> n_limbs: array<u32>;
@group(0) @binding(2) var<storage, read> ninv_buf: array<u32>;
@group(0) @binding(3) var<storage, read_write> x_limbs: array<u32>;
@group(0) @binding(4) var<storage, read> e_words: array<u32>;   // n - 1, words per instance = fp.z
@group(0) @binding(5) var<uniform> fp: vec4<u32>;               // x = first iteration, y = nbits, z = words per instance

fn bcast(v: u32, src_lane: u32, base: u32) -> u32 { return subgroupShuffle(v, base + src_lane); }
fn down1(v: u32, lane: u32) -> u32 { return select(0u, subgroupShuffleDown(v, 1u), lane != TPI - 1u); }
fn up1(v: u32, lane: u32) -> u32 { return select(0u, subgroupShuffleUp(v, 1u), lane != 0u); }
fn any_nonzero(v: u32) -> bool { return subgroupAny(v != 0u); }

@compute @workgroup_size(WG)
fn main(@builtin(workgroup_id) wid: vec3<u32>, @builtin(local_invocation_index) li: u32, @builtin(subgroup_invocation_id) sg_in: u32) {
    let sg = sg_in;
    let lane = sg % TPI;
    let base = sg - lane;
    let inst = wid.x * (WG / TPI) + li / TPI;
    let live = inst < params.x;
    let ic = min(inst, params.x - 1u);     // out-of-range lanes compute on a valid instance; their store is skipped
    let off = ic * L + lane * LPL;
    var x0 = x_limbs[off + 0u];
    var x1 = x_limbs[off + 1u];
    var x2 = x_limbs[off + 2u];
    let n0 = n_limbs[off];
    let ninv = ninv_buf[ic] & MASK;                   // already below 2^13; the explicit mask lets the compiler see the m product fits 24 bits
    let is0 = select(0u, 0xffffffffu, lane == 0u);   // all ones on lane 0 only
    let N0 = bcast(n0, 0u, base);                     // lane 0's limb 0 of n
    let NN0 = down1(n0, lane);                        // next lane's limb 0 of n (0 for the last lane)
    for (var s = 0u; s < params.y; s++) {
        var lo0 = 0u;
        var hi0 = 0u;
        var lo1 = 0u;
        var hi1 = 0u;
        var lo2 = 0u;
        var hi2 = 0u;
        {
            let role = (lane + 0u) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 0u >= TPI;
            let pi = select(0u, role + 0u - 4u, wrap);       // block p of this lane's pair
            let qi = select(role + 0u, 4u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            let ap0 = bcast(x0, pi, base) & 0xffffffu;
            let ap1 = bcast(x1, pi, base) & 0xffffffu;
            let ap2 = bcast(x2, pi, base) & 0xffffffu;
            var ph0 = 0u;
            var ph1 = 0u;
            var ph2 = 0u;
            {
                let bq = x0;
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
                lo1 += ap1 * dj;
                lo2 += ap2 * dj;
            }
            {
                let bq = x1;
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 1 of D_q, below 2^14
                lo1 += ap0 * dj;
                lo2 += ap1 * dj;
                ph0 += ap2 * dj;
            }
            {
                let bq = x2;
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 2 of D_q, below 2^14
                lo2 += ap0 * dj;
                ph0 += ap1 * dj;
                ph1 += ap2 * dj;
            }
            // light pass over the block product: each word keeps its low 13 bits plus the carry of the word below; the top word keeps everything (bounds checked at generation)
            {
                let o0 = lo0;
                let o1 = lo1;
                let o2 = lo2;
                let o3 = ph0;
                let o4 = ph1;
                lo0 = (o0 & MASK);
                lo1 = (o1 & MASK) + (o0 >> B);
                lo2 = (o2 & MASK) + (o1 >> B);
                ph0 = (o3 & MASK) + (o2 >> B);
                ph1 = (o4 & MASK) + (o3 >> B);
                ph2 = ph2 + (o4 >> B);
            }
            let below = (lane + TPI - 1u) & (TPI - 1u);       // the lane whose high half lands here
            let to_hi = lane == 0u;
            { let v = bcast(ph0, below, base); lo0 += select(v, 0u, to_hi); hi0 += select(0u, v, to_hi); }
            { let v = bcast(ph1, below, base); lo1 += select(v, 0u, to_hi); hi1 += select(0u, v, to_hi); }
            { let v = bcast(ph2, below, base); lo2 += select(v, 0u, to_hi); hi2 += select(0u, v, to_hi); }
        }
        {
            let all = lo0 | hi0 | lo1 | hi1 | lo2 | hi2;
            let role = (lane + 6u + (all & params.z)) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 1u >= TPI;
            let pi = select(1u, role + 1u - 4u, wrap);       // block p of this lane's pair
            let qi = select(role + 1u, 5u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            // exchange lo and hi on these lanes, so that lo names the block that receives this lane's low half
            let sw = lane >= 0u && lane < 2u;
            { let a = select(lo0, hi0, sw); hi0 = select(hi0, lo0, sw); lo0 = a; }
            { let a = select(lo1, hi1, sw); hi1 = select(hi1, lo1, sw); lo1 = a; }
            { let a = select(lo2, hi2, sw); hi2 = select(hi2, lo2, sw); lo2 = a; }
            let ap0 = bcast(x0, pi, base) & 0xffffffu;
            let ap1 = bcast(x1, pi, base) & 0xffffffu;
            let ap2 = bcast(x2, pi, base) & 0xffffffu;
            var ph0 = 0u;
            var ph1 = 0u;
            var ph2 = 0u;
            {
                let bq = bcast(x0, qi, base);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
                lo1 += ap1 * dj;
                lo2 += ap2 * dj;
            }
            {
                let bq = bcast(x1, qi, base);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 1 of D_q, below 2^14
                lo1 += ap0 * dj;
                lo2 += ap1 * dj;
                ph0 += ap2 * dj;
            }
            {
                let bq = bcast(x2, qi, base);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 2 of D_q, below 2^14
                lo2 += ap0 * dj;
                ph0 += ap1 * dj;
                ph1 += ap2 * dj;
            }
            // light pass over the block product: each word keeps its low 13 bits plus the carry of the word below; the top word keeps everything (bounds checked at generation)
            {
                let o0 = lo0;
                let o1 = lo1;
                let o2 = lo2;
                let o3 = ph0;
                let o4 = ph1;
                lo0 = (o0 & MASK);
                lo1 = (o1 & MASK) + (o0 >> B);
                lo2 = (o2 & MASK) + (o1 >> B);
                ph0 = (o3 & MASK) + (o2 >> B);
                ph1 = (o4 & MASK) + (o3 >> B);
                ph2 = ph2 + (o4 >> B);
            }
            let below = (lane + TPI - 1u) & (TPI - 1u);       // the lane whose high half lands here
            let to_hi = lane == 2u;
            { let v = bcast(ph0, below, base); lo0 += select(v, 0u, to_hi); hi0 += select(0u, v, to_hi); }
            { let v = bcast(ph1, below, base); lo1 += select(v, 0u, to_hi); hi1 += select(0u, v, to_hi); }
            { let v = bcast(ph2, below, base); lo2 += select(v, 0u, to_hi); hi2 += select(0u, v, to_hi); }
        }
        {
            let all = lo0 | hi0 | lo1 | hi1 | lo2 | hi2;
            let role = (lane + 4u + (all & params.z)) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 2u >= TPI;
            let pi = select(2u, role + 2u - 4u, wrap);       // block p of this lane's pair
            let qi = select(role + 2u, 6u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            // exchange lo and hi on these lanes, so that lo names the block that receives this lane's low half
            let sw = lane >= 2u && lane < 4u;
            { let a = select(lo0, hi0, sw); hi0 = select(hi0, lo0, sw); lo0 = a; }
            { let a = select(lo1, hi1, sw); hi1 = select(hi1, lo1, sw); lo1 = a; }
            { let a = select(lo2, hi2, sw); hi2 = select(hi2, lo2, sw); lo2 = a; }
            let ap0 = bcast(x0, pi, base) & 0xffffffu;
            let ap1 = bcast(x1, pi, base) & 0xffffffu;
            let ap2 = bcast(x2, pi, base) & 0xffffffu;
            var ph0 = 0u;
            var ph1 = 0u;
            var ph2 = 0u;
            {
                let bq = bcast(x0, qi, base);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
                lo1 += ap1 * dj;
                lo2 += ap2 * dj;
            }
            {
                let bq = bcast(x1, qi, base);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 1 of D_q, below 2^14
                lo1 += ap0 * dj;
                lo2 += ap1 * dj;
                ph0 += ap2 * dj;
            }
            {
                let bq = bcast(x2, qi, base);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 2 of D_q, below 2^14
                lo2 += ap0 * dj;
                ph0 += ap1 * dj;
                ph1 += ap2 * dj;
            }
            // light pass over the block product: each word keeps its low 13 bits plus the carry of the word below; the top word keeps everything (bounds checked at generation)
            {
                let o0 = lo0;
                let o1 = lo1;
                let o2 = lo2;
                let o3 = ph0;
                let o4 = ph1;
                lo0 = (o0 & MASK);
                lo1 = (o1 & MASK) + (o0 >> B);
                lo2 = (o2 & MASK) + (o1 >> B);
                ph0 = (o3 & MASK) + (o2 >> B);
                ph1 = (o4 & MASK) + (o3 >> B);
                ph2 = ph2 + (o4 >> B);
            }
            let below = (lane + TPI - 1u) & (TPI - 1u);       // the lane whose high half lands here
            let to_hi = lane == 4u;
            { let v = bcast(ph0, below, base); lo0 += select(v, 0u, to_hi); hi0 += select(0u, v, to_hi); }
            { let v = bcast(ph1, below, base); lo1 += select(v, 0u, to_hi); hi1 += select(0u, v, to_hi); }
            { let v = bcast(ph2, below, base); lo2 += select(v, 0u, to_hi); hi2 += select(0u, v, to_hi); }
        }
        {
            let all = lo0 | hi0 | lo1 | hi1 | lo2 | hi2;
            let role = (lane + 2u + (all & params.z)) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 3u >= TPI;
            let pi = select(3u, role + 3u - 4u, wrap);       // block p of this lane's pair
            let qi = select(role + 3u, 7u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            // exchange lo and hi on these lanes, so that lo names the block that receives this lane's low half
            let sw = lane >= 4u && lane < 6u;
            { let a = select(lo0, hi0, sw); hi0 = select(hi0, lo0, sw); lo0 = a; }
            { let a = select(lo1, hi1, sw); hi1 = select(hi1, lo1, sw); lo1 = a; }
            { let a = select(lo2, hi2, sw); hi2 = select(hi2, lo2, sw); lo2 = a; }
            let ap0 = bcast(x0, pi, base) & 0xffffffu;
            let ap1 = bcast(x1, pi, base) & 0xffffffu;
            let ap2 = bcast(x2, pi, base) & 0xffffffu;
            var ph0 = 0u;
            var ph1 = 0u;
            var ph2 = 0u;
            {
                let bq = bcast(x0, qi, base);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
                lo1 += ap1 * dj;
                lo2 += ap2 * dj;
            }
            {
                let bq = bcast(x1, qi, base);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 1 of D_q, below 2^14
                lo1 += ap0 * dj;
                lo2 += ap1 * dj;
                ph0 += ap2 * dj;
            }
            {
                let bq = bcast(x2, qi, base);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 2 of D_q, below 2^14
                lo2 += ap0 * dj;
                ph0 += ap1 * dj;
                ph1 += ap2 * dj;
            }
            // light pass over the block product: each word keeps its low 13 bits plus the carry of the word below; the top word keeps everything (bounds checked at generation)
            {
                let o0 = lo0;
                let o1 = lo1;
                let o2 = lo2;
                let o3 = ph0;
                let o4 = ph1;
                lo0 = (o0 & MASK);
                lo1 = (o1 & MASK) + (o0 >> B);
                lo2 = (o2 & MASK) + (o1 >> B);
                ph0 = (o3 & MASK) + (o2 >> B);
                ph1 = (o4 & MASK) + (o3 >> B);
                ph2 = ph2 + (o4 >> B);
            }
            let below = (lane + TPI - 1u) & (TPI - 1u);       // the lane whose high half lands here
            let to_hi = lane == 6u;
            { let v = bcast(ph0, below, base); lo0 += select(v, 0u, to_hi); hi0 += select(0u, v, to_hi); }
            { let v = bcast(ph1, below, base); lo1 += select(v, 0u, to_hi); hi1 += select(0u, v, to_hi); }
            { let v = bcast(ph2, below, base); lo2 += select(v, 0u, to_hi); hi2 += select(0u, v, to_hi); }
        }
        // exchange lo and hi on these lanes, so that lo names the block that receives this lane's low half
        let sw = lane < 6u;
        { let a = select(lo0, hi0, sw); hi0 = select(hi0, lo0, sw); lo0 = a; }
        { let a = select(lo1, hi1, sw); hi1 = select(hi1, lo1, sw); lo1 = a; }
        { let a = select(lo2, hi2, sw); hi2 = select(hi2, lo2, sw); lo2 = a; }
        {
            let all = lo0 | hi0 | lo1 | hi1 | lo2 | hi2;
            let ai = 4u + (lane >> 1u) + (all & params.z);
            let dg0 = bcast(x0, ai, base) & 0xffffffu;
            let dg1 = bcast(x1, ai, base) & 0xffffffu;
            let dg2 = bcast(x2, ai, base) & 0xffffffu;
            var pw0 = 0u;
            var pw1 = 0u;
            var pw2 = 0u;
            var pw3 = 0u;
            var pw4 = 0u;
            var pw5 = 0u;
            {
                pw0 += dg0 * dg0;
                let dj = (dg0 << 1u) & 0xffffffu;
                pw1 += dg1 * dj;
                pw2 += dg2 * dj;
            }
            {
                pw2 += dg1 * dg1;
                let dj = (dg1 << 1u) & 0xffffffu;
                pw3 += dg2 * dj;
            }
            {
                pw4 += dg2 * dg2;
            }
            // light pass over the block product: each word keeps its low 13 bits plus the carry of the word below; the top word keeps everything (bounds checked at generation)
            {
                let o0 = pw0;
                let o1 = pw1;
                let o2 = pw2;
                let o3 = pw3;
                let o4 = pw4;
                pw0 = (o0 & MASK);
                pw1 = (o1 & MASK) + (o0 >> B);
                pw2 = (o2 & MASK) + (o1 >> B);
                pw3 = (o3 & MASK) + (o2 >> B);
                pw4 = (o4 & MASK) + (o3 >> B);
                pw5 = pw5 + (o4 >> B);
            }
            let odd = (lane & 1u) == 1u;
            hi0 += select(pw0, pw3, odd);
            hi1 += select(pw1, pw4, odd);
            hi2 += select(pw2, pw5, odd);
        }
        let n1 = n_limbs[off + 1u];
        let n2 = n_limbs[off + 2u];
        var t0 = lo0;
        var t1 = lo1;
        var t2 = lo2;
        for (var owner = 0u; owner < TPI; owner++) {
            {
                // new t = old t shifted down one limb plus n*m shifted the same way (no x*b: the square is formed already); each line reads the old value above it
                let T0 = bcast(t0, 0u, base);               // window limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's window limb 0 (0 for the last lane)
                let m = ((T0 & MASK) * ninv) & MASK;        // Montgomery factor: only the low 13 bits matter (24-bit multiply)
                let carry0 = (T0 + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                t0 = t1 + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (n2 & 0xffffffu) * m;
                t2 = TN + (NN0 & 0xffffffu) * m;
            }
            {
                // new t = old t shifted down one limb plus n*m shifted the same way (no x*b: the square is formed already); each line reads the old value above it
                let T0 = bcast(t0, 0u, base);               // window limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's window limb 0 (0 for the last lane)
                let m = ((T0 & MASK) * ninv) & MASK;        // Montgomery factor: only the low 13 bits matter (24-bit multiply)
                let carry0 = (T0 + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                t0 = t1 + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (n2 & 0xffffffu) * m;
                t2 = TN + (NN0 & 0xffffffu) * m;
            }
            {
                // new t = old t shifted down one limb plus n*m shifted the same way (no x*b: the square is formed already); each line reads the old value above it
                let T0 = bcast(t0, 0u, base);               // window limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's window limb 0 (0 for the last lane)
                let m = ((T0 & MASK) * ninv) & MASK;        // Montgomery factor: only the low 13 bits matter (24-bit multiply)
                let carry0 = (T0 + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                t0 = t1 + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (n2 & 0xffffffu) * m;
                t2 = TN + (NN0 & 0xffffffu) * m;
            }
            if ((owner % K) == K - 1u) {
                {
                    var c_in = up1(t2 >> B, lane);   // read before any limb is modified
                    let v0 = t0;
                    t0 = (v0 & MASK) + c_in;
                    c_in = v0 >> B;
                    let v1 = t1;
                    t1 = (v1 & MASK) + c_in;
                    c_in = v1 >> B;
                    let v2 = t2;
                    t2 = (v2 & MASK) + c_in;
                    c_in = v2 >> B;
                }
            }
        }
        // + S_hi: lane j's block TPI + j of x^2 has the weight of the result's block j
        t0 += hi0;
        t1 += hi1;
        t2 += hi2;
        for (var round = 0u; round < L + 2u; round++) {
            let big = (t0 >> B) | (t1 >> B) | (t2 >> B);
            if (!any_nonzero(big)) { break; }
            {
                var c_in = up1(t2 >> B, lane);   // read before any limb is modified
                let v0 = t0;
                t0 = (v0 & MASK) + c_in;
                c_in = v0 >> B;
                let v1 = t1;
                t1 = (v1 & MASK) + c_in;
                c_in = v1 >> B;
                let v2 = t2;
                t2 = (v2 & MASK) + c_in;
                c_in = v2 >> B;
            }
        }
        x0 = t0;
        x1 = t1;
        x2 = t2;
        let gi = fp.y - 2u - (fp.x + s);
        let ebit = (e_words[ic * fp.z + (gi >> 5u)] >> (gi & 31u)) & 1u;
        t0 = x0 << 1u;
        t1 = x1 << 1u;
        t2 = x2 << 1u;
        for (var round = 0u; round < L + 2u; round++) {
            let big = (t0 >> B) | (t1 >> B) | (t2 >> B);
            if (!any_nonzero(big)) { break; }
            {
                var c_in = up1(t2 >> B, lane);   // read before any limb is modified
                let v0 = t0;
                t0 = (v0 & MASK) + c_in;
                c_in = v0 >> B;
                let v1 = t1;
                t1 = (v1 & MASK) + c_in;
                c_in = v1 >> B;
                let v2 = t2;
                t2 = (v2 & MASK) + c_in;
                c_in = v2 >> B;
            }
        }
        x0 = select(x0, t0, ebit == 1u);
        x1 = select(x1, t1, ebit == 1u);
        x2 = select(x2, t2, ebit == 1u);
    }
    if (live) {
        x_limbs[off + 0u] = x0;
        x_limbs[off + 1u] = x1;
        x_limbs[off + 2u] = x2;
    }
}
