                    let a = u64(x4) * bb + u64(t4) + c1;
                    c1 = a >> 32u;
                    let q = u64(n4) * mm + u64(u32(a)) + c2;
                    t3 = u32(q);
                    c2 = q >> 32u;
                }
                {
                    let a = u64(x5) * bb + u64(t5) + c1;
                    c1 = a >> 32u;
                    let q = u64(n5) * mm + u64(u32(a)) + c2;
                    t4 = u32(q);
                    c2 = q >> 32u;
                }
                {
                    let a = u64(x6) * bb + u64(t6) + c1;
                    c1 = a >> 32u;
                    let q = u64(n6) * mm + u64(u32(a)) + c2;
                    t5 = u32(q);
                    c2 = q >> 32u;
                }
                {
                    let a = u64(x7) * bb + u64(t7) + c1;
                    c1 = a >> 32u;
                    let q = u64(n7) * mm + u64(u32(a)) + c2;
                    t6 = u32(q);
                    c2 = q >> 32u;
                }
                {
                    let a = u64(XN0) * bb + u64(TN) + c1;            // the next lane's limb 0, computed here
                    let q = u64(NN0) * mm + u64(u32(a)) + c2;
                    let s2 = q + pend;                               // pend below 2^34: wraps at most once
                    let wrap = select(0lu, 4294967296lu, s2 < q);
                    t7 = u32(s2);
                    pend = (s2 >> 32u) + wrap + (a >> 32u);         // below 2^33 + 4 (see the note on `step`)
                }
            }
            {
                let bb = u64(bcast(x7, owner, base));       // multiplier limb
                let T0 = bcast(t0, 0u, base);                   // accumulator limb 0 of lane 0
                let TN = down1(t0, lane);                       // next lane's accumulator limb 0 (0 for the last lane)
                let a0 = u64(T0) + u64(X0) * bb;                // lane 0's limb 0 after adding x*b
                let m = u32(a0) * ninv;                         // Montgomery factor (u32 wrapping)
                let mm = u64(m);
                let b0 = u64(u32(a0)) + u64(N0) * mm;           // low word is zero
                var c1 = select(0lu, a0 >> 32u, is0);           // carries of limb 0 enter lane 0's first element
                var c2 = select(0lu, b0 >> 32u, is0);
                {
                    let a = u64(x1) * bb + u64(t1) + c1;
                    c1 = a >> 32u;
                    let q = u64(n1) * mm + u64(u32(a)) + c2;
                    t0 = u32(q);
                    c2 = q >> 32u;
                }
                {
                    let a = u64(x2) * bb + u64(t2) + c1;
                    c1 = a >> 32u;
                    let q = u64(n2) * mm + u64(u32(a)) + c2;
                    t1 = u32(q);
                    c2 = q >> 32u;
                }
                {
                    let a = u64(x3) * bb + u64(t3) + c1;
                    c1 = a >> 32u;
                    let q = u64(n3) * mm + u64(u32(a)) + c2;
                    t2 = u32(q);
                    c2 = q >> 32u;
                }
                {
                    let a = u64(x4) * bb + u64(t4) + c1;
                    c1 = a >> 32u;
                    let q = u64(n4) * mm + u64(u32(a)) + c2;
                    t3 = u32(q);
                    c2 = q >> 32u;
                }
                {
                    let a = u64(x5) * bb + u64(t5) + c1;
                    c1 = a >> 32u;
                    let q = u64(n5) * mm + u64(u32(a)) + c2;
                    t4 = u32(q);
                    c2 = q >> 32u;
                }
                {
                    let a = u64(x6) * bb + u64(t6) + c1;
                    c1 = a >> 32u;
                    let q = u64(n6) * mm + u64(u32(a)) + c2;
                    t5 = u32(q);
                    c2 = q >> 32u;
                }
                {
                    let a = u64(x7) * bb + u64(t7) + c1;
                    c1 = a >> 32u;
                    let q = u64(n7) * mm + u64(u32(a)) + c2;
                    t6 = u32(q);
                    c2 = q >> 32u;
                }
                {
                    let a = u64(XN0) * bb + u64(TN) + c1;            // the next lane's limb 0, computed here
                    let q = u64(NN0) * mm + u64(u32(a)) + c2;
                    let s2 = q + pend;                               // pend below 2^34: wraps at most once
                    let wrap = select(0lu, 4294967296lu, s2 < q);
                    t7 = u32(s2);
                    pend = (s2 >> 32u) + wrap + (a >> 32u);         // below 2^33 + 4 (see the note on `step`)
                }
            }
        }
        for (var round = 0u; round < L + 2u; round++) {
            let plo = u32(pend);
            let phi = u32(pend >> 32u);
            if (!any_nonzero(plo | phi)) { break; }
            var carry = u64(up1(plo, lane)) + (u64(up1(phi, lane)) << 32u);
            let v0 = u64(t0) + carry;
            t0 = u32(v0);
            carry = v0 >> 32u;
            let v1 = u64(t1) + carry;
            t1 = u32(v1);
            carry = v1 >> 32u;
            let v2 = u64(t2) + carry;
            t2 = u32(v2);
            carry = v2 >> 32u;
            let v3 = u64(t3) + carry;
            t3 = u32(v3);
            carry = v3 >> 32u;
            let v4 = u64(t4) + carry;
            t4 = u32(v4);
            carry = v4 >> 32u;
            let v5 = u64(t5) + carry;
            t5 = u32(v5);
            carry = v5 >> 32u;
            let v6 = u64(t6) + carry;
            t6 = u32(v6);
            carry = v6 >> 32u;
            let v7 = u64(t7) + carry;
            t7 = u32(v7);
            carry = v7 >> 32u;
            pend = carry;
        }
        x0 = t0;
        x1 = t1;
        x2 = t2;
        x3 = t3;
        x4 = t4;
        x5 = t5;
        x6 = t6;
        x7 = t7;
        let gi = fp.y - 2u - (fp.x + s);
        let ebit = (e_words[ic * fp.z + (gi >> 5u)] >> (gi & 31u)) & 1u;
        var prev = up1(x7 >> 31u, lane);                 // bit shifted in from the lane below (0 for lane 0)
        let d0 = (x0 << 1u) | prev;
        prev = x0 >> 31u;
        let d1 = (x1 << 1u) | prev;
        prev = x1 >> 31u;
        let d2 = (x2 << 1u) | prev;
        prev = x2 >> 31u;
        let d3 = (x3 << 1u) | prev;
        prev = x3 >> 31u;
        let d4 = (x4 << 1u) | prev;
        prev = x4 >> 31u;
        let d5 = (x5 << 1u) | prev;
        prev = x5 >> 31u;
        let d6 = (x6 << 1u) | prev;
        prev = x6 >> 31u;
        let d7 = (x7 << 1u) | prev;
        prev = x7 >> 31u;
        x0 = select(x0, d0, ebit == 1u);
        x1 = select(x1, d1, ebit == 1u);
        x2 = select(x2, d2, ebit == 1u);
        x3 = select(x3, d3, ebit == 1u);
        x4 = select(x4, d4, ebit == 1u);
        x5 = select(x5, d5, ebit == 1u);
        x6 = select(x6, d6, ebit == 1u);
        x7 = select(x7, d7, ebit == 1u);
    }
    if (live) {
        x_limbs[off + 0u] = x0;
        x_limbs[off + 1u] = x1;
        x_limbs[off + 2u] = x2;
        x_limbs[off + 3u] = x3;
        x_limbs[off + 4u] = x4;
        x_limbs[off + 5u] = x5;
        x_limbs[off + 6u] = x6;
        x_limbs[off + 7u] = x7;
    }
}
