            var ph1 = 0u;
            var ph2 = 0u;
            var ph3 = 0u;
            var ph4 = 0u;
            var ph5 = 0u;
            var ph6 = 0u;
            var ph7 = 0u;
            var ph8 = 0u;
            var ph9 = 0u;
            var ph10 = 0u;
            var ph11 = 0u;
            var ph12 = 0u;
            var ph13 = 0u;
            var ph14 = 0u;
            var ph15 = 0u;
            var ph16 = 0u;
            var ph17 = 0u;
            var ph18 = 0u;
            var ph19 = 0u;
            let bw0 = xp0;
            {
                let bq = (bw0 & MASK);
                let dj = select(bq << 1u, bq, single) & 0xffffffu;   // limb 0 of D_q, below 2^14
                lo0 += ap0 * dj;
                lo1 += ap1 * dj;
                lo2 += ap2 * dj;
                lo3 += ap3 * dj;
                lo4 += ap4 * dj;
                lo5 += ap5 * dj;
