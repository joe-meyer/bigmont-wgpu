enable subgroups;
diagnostic(off, subgroup_uniformity);
// Generated by bigmont-core unrolledsq.rs: TPI 8, 20 limbs per lane, symmetric squaring then reduction.
const TPI: u32 = 8u;     // lanes per number
const LPL: u32 = 20u;     // limbs per lane; TPI * LPL = number of limbs
const L: u32 = TPI * LPL;
const WG: u32 = 64u;
const B: u32 = 13u;
const MASK: u32 = 0x1fffu;
const K: u32 = 3u;       // reduction owners between light carry passes (K * LPL <= 63 steps)

@group(0) @binding(0) var<uniform> params: vec4<u32>;          // x = instance count, y = ladder iterations in this dispatch
@group(0) @binding(1) var<storage, read> n_limbs: array<u32>;
@group(0) @binding(2) var<storage, read> ninv_buf: array<u32>;
@group(0) @binding(3) var<storage, read_write> x_limbs: array<u32>;
@group(0) @binding(4) var<storage, read> e_words: array<u32>;   // n - 1, words per instance = fp.z
@group(0) @binding(5) var<uniform> fp: vec4<u32>;               // x = first iteration, y = nbits, z = words per instance

fn bcast(v: u32, src_lane: u32, base: u32) -> u32 { return subgroupShuffle(v, base + src_lane); }
fn down1(v: u32, lane: u32) -> u32 { return select(0u, subgroupShuffleDown(v, 1u), lane != TPI - 1u); }
fn up1(v: u32, lane: u32) -> u32 { return select(0u, subgroupShuffleUp(v, 1u), lane != 0u); }
fn any_nonzero(v: u32) -> bool { return subgroupAny(v != 0u); }

@compute @workgroup_size(WG)
fn main(@builtin(workgroup_id) wid: vec3<u32>, @builtin(local_invocation_index) li: u32, @builtin(subgroup_invocation_id) sg_in: u32) {
    let sg = sg_in;
    let lane = sg % TPI;
    let base = sg - lane;
    let inst = wid.x * (WG / TPI) + li / TPI;
    let live = inst < params.x;
    let ic = min(inst, params.x - 1u);     // out-of-range lanes compute on a valid instance; their store is skipped
    let off = ic * L + lane * LPL;
    var x0 = x_limbs[off + 0u];
    var x1 = x_limbs[off + 1u];
    var x2 = x_limbs[off + 2u];
    var x3 = x_limbs[off + 3u];
    var x4 = x_limbs[off + 4u];
    var x5 = x_limbs[off + 5u];
    var x6 = x_limbs[off + 6u];
    var x7 = x_limbs[off + 7u];
    var x8 = x_limbs[off + 8u];
    var x9 = x_limbs[off + 9u];
    var x10 = x_limbs[off + 10u];
    var x11 = x_limbs[off + 11u];
    var x12 = x_limbs[off + 12u];
    var x13 = x_limbs[off + 13u];
    var x14 = x_limbs[off + 14u];
    var x15 = x_limbs[off + 15u];
    var x16 = x_limbs[off + 16u];
    var x17 = x_limbs[off + 17u];
    var x18 = x_limbs[off + 18u];
    var x19 = x_limbs[off + 19u];
    let n0 = n_limbs[off];
    let ninv = ninv_buf[ic] & MASK;                   // already below 2^13; the explicit mask lets the compiler see the m product fits 24 bits
    let is0 = select(0u, 0xffffffffu, lane == 0u);   // all ones on lane 0 only
    let N0 = bcast(n0, 0u, base);                     // lane 0's limb 0 of n
    let NN0 = down1(n0, lane);                        // next lane's limb 0 of n (0 for the last lane)
    for (var s = 0u; s < params.y; s++) {
        let xp0 = x0 | (x1 << 16u);
        let xp1 = x2 | (x3 << 16u);
        let xp2 = x4 | (x5 << 16u);
        let xp3 = x6 | (x7 << 16u);
        let xp4 = x8 | (x9 << 16u);
        let xp5 = x10 | (x11 << 16u);
        let xp6 = x12 | (x13 << 16u);
        let xp7 = x14 | (x15 << 16u);
        let xp8 = x16 | (x17 << 16u);
        let xp9 = x18 | (x19 << 16u);
        var lo0 = 0u;
        var hi0 = 0u;
        var lo1 = 0u;
        var hi1 = 0u;
        var lo2 = 0u;
        var hi2 = 0u;
        var lo3 = 0u;
        var hi3 = 0u;
        var lo4 = 0u;
        var hi4 = 0u;
        var lo5 = 0u;
        var hi5 = 0u;
        var lo6 = 0u;
        var hi6 = 0u;
        var lo7 = 0u;
        var hi7 = 0u;
        var lo8 = 0u;
        var hi8 = 0u;
        var lo9 = 0u;
        var hi9 = 0u;
        var lo10 = 0u;
        var hi10 = 0u;
        var lo11 = 0u;
        var hi11 = 0u;
        var lo12 = 0u;
        var hi12 = 0u;
        var lo13 = 0u;
        var hi13 = 0u;
        var lo14 = 0u;
        var hi14 = 0u;
        var lo15 = 0u;
        var hi15 = 0u;
        var lo16 = 0u;
        var hi16 = 0u;
        var lo17 = 0u;
        var hi17 = 0u;
        var lo18 = 0u;
        var hi18 = 0u;
        var lo19 = 0u;
        var hi19 = 0u;
        {
            let role = (lane + 0u) & (TPI - 1u);       // l = (lane - 2 i) mod TPI
            let wrap = role + 0u >= TPI;
            let pi = select(0u, role + 0u - 4u, wrap);       // block p of this lane's pair
            let qi = select(role + 0u, 4u, wrap);                  // block q; p + q = role + 2 i = lane (mod TPI)
            let single = role == 0u;                         // p == q only for role 0: that product must not be doubled
            let aw0 = bcast(xp0, pi, base);
            let aw1 = bcast(xp1, pi, base);
            let aw2 = bcast(xp2, pi, base);
            let aw3 = bcast(xp3, pi, base);
            let aw4 = bcast(xp4, pi, base);
            let aw5 = bcast(xp5, pi, base);
            let aw6 = bcast(xp6, pi, base);
            let aw7 = bcast(xp7, pi, base);
            let aw8 = bcast(xp8, pi, base);
            let aw9 = bcast(xp9, pi, base);
            let ap0 = (aw0 & MASK);
            let ap1 = (aw0 >> 16u);
            let ap2 = (aw1 & MASK);
            let ap3 = (aw1 >> 16u);
            let ap4 = (aw2 & MASK);
            let ap5 = (aw2 >> 16u);
            let ap6 = (aw3 & MASK);
            let ap7 = (aw3 >> 16u);
            let ap8 = (aw4 & MASK);
            let ap9 = (aw4 >> 16u);
            let ap10 = (aw5 & MASK);
            let ap11 = (aw5 >> 16u);
            let ap12 = (aw6 & MASK);
            let ap13 = (aw6 >> 16u);
            let ap14 = (aw7 & MASK);
            let ap15 = (aw7 >> 16u);
            let ap16 = (aw8 & MASK);
            let ap17 = (aw8 >> 16u);
            let ap18 = (aw9 & MASK);
            let ap19 = (aw9 >> 16u);
