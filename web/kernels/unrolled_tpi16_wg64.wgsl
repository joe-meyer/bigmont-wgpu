// Generated by bigmont-core unrolled.rs: straight-line limb arithmetic, named scalar limbs.
const TPI: u32 = 16u;     // lanes per number
const LPL: u32 = 10u;     // limbs per lane; TPI * LPL = 160
const L: u32 = TPI * LPL;
const WG: u32 = 64u;
const B: u32 = 13u;
const MASK: u32 = 0x1fffu;
const K: u32 = 2u;       // owners between light carry passes (K * LPL = 20 iterations, PERIOD caps it at 24)

@group(0) @binding(0) var<uniform> params: vec4<u32>;          // x = instance count, y = squarings
@group(0) @binding(1) var<storage, read> n_limbs: array<u32>;
@group(0) @binding(2) var<storage, read> ninv_buf: array<u32>;
@group(0) @binding(3) var<storage, read_write> x_limbs: array<u32>;

fn bcast(v: u32, src_lane: u32, base: u32) -> u32 { return subgroupShuffle(v, base + src_lane); }
fn down1(v: u32, lane: u32) -> u32 { return select(0u, subgroupShuffleDown(v, 1u), lane != TPI - 1u); }
fn up1(v: u32, lane: u32) -> u32 { return select(0u, subgroupShuffleUp(v, 1u), lane != 0u); }
fn any_nonzero(v: u32) -> bool { return subgroupAny(v != 0u); }

@compute @workgroup_size(WG)
fn main(@builtin(workgroup_id) wid: vec3<u32>, @builtin(local_invocation_index) li: u32, @builtin(subgroup_invocation_id) sg_in: u32) {
    let sg = sg_in;
    let lane = sg % TPI;
    let base = sg - lane;
    let inst = wid.x * (WG / TPI) + li / TPI;
    let live = inst < params.x;
    let ic = min(inst, params.x - 1u);     // out-of-range lanes compute on a valid instance; their store is skipped
    let off = ic * L + lane * LPL;
    var x0 = x_limbs[off + 0u];
    var x1 = x_limbs[off + 1u];
    var x2 = x_limbs[off + 2u];
    var x3 = x_limbs[off + 3u];
    var x4 = x_limbs[off + 4u];
    var x5 = x_limbs[off + 5u];
    var x6 = x_limbs[off + 6u];
    var x7 = x_limbs[off + 7u];
    var x8 = x_limbs[off + 8u];
    var x9 = x_limbs[off + 9u];
    let n0 = n_limbs[off + 0u];
    let n1 = n_limbs[off + 1u];
    let n2 = n_limbs[off + 2u];
    let n3 = n_limbs[off + 3u];
    let n4 = n_limbs[off + 4u];
    let n5 = n_limbs[off + 5u];
    let n6 = n_limbs[off + 6u];
    let n7 = n_limbs[off + 7u];
    let n8 = n_limbs[off + 8u];
    let n9 = n_limbs[off + 9u];
    var t0 = 0u;
    var t1 = 0u;
    var t2 = 0u;
    var t3 = 0u;
    var t4 = 0u;
    var t5 = 0u;
    var t6 = 0u;
    var t7 = 0u;
    var t8 = 0u;
    var t9 = 0u;
    let ninv = ninv_buf[ic];
    let is0 = select(0u, 0xffffffffu, lane == 0u);   // all ones on lane 0 only
    let N0 = bcast(n0, 0u, base);                     // lane 0's limb 0 of n
    let NN0 = down1(n0, lane);                        // next lane's limb 0 of n (0 for the last lane)
    for (var s = 0u; s < params.y; s++) {
        let X0 = bcast(x0, 0u, base);
        let XN0 = down1(x0, lane);
        t0 = 0u;
        t1 = 0u;
        t2 = 0u;
        t3 = 0u;
        t4 = 0u;
        t5 = 0u;
        t6 = 0u;
        t7 = 0u;
        t8 = 0u;
        t9 = 0u;
        for (var owner = 0u; owner < TPI; owner++) {
            {
                let bl = bcast(x0, owner, base) & 0xffffffu;    // next limb of the multiplier
                let T0 = bcast(t0, 0u, base);               // accumulator limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's accumulator limb 0 (0 for the last lane)
                let p = T0 + (X0 & 0xffffffu) * bl;            // lane 0's limb 0 after adding x*b
                let m = (p * ninv) & MASK;                 // Montgomery factor
                let carry0 = (p + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                // new t = old t shifted down one limb, plus x*b and n*m shifted the same way; each line reads the old value above it
                t0 = t1 + (x1 & 0xffffffu) * bl + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (x2 & 0xffffffu) * bl + (n2 & 0xffffffu) * m;
                t2 = t3 + (x3 & 0xffffffu) * bl + (n3 & 0xffffffu) * m;
                t3 = t4 + (x4 & 0xffffffu) * bl + (n4 & 0xffffffu) * m;
                t4 = t5 + (x5 & 0xffffffu) * bl + (n5 & 0xffffffu) * m;
                t5 = t6 + (x6 & 0xffffffu) * bl + (n6 & 0xffffffu) * m;
                t6 = t7 + (x7 & 0xffffffu) * bl + (n7 & 0xffffffu) * m;
                t7 = t8 + (x8 & 0xffffffu) * bl + (n8 & 0xffffffu) * m;
                t8 = t9 + (x9 & 0xffffffu) * bl + (n9 & 0xffffffu) * m;
                t9 = TN + (XN0 & 0xffffffu) * bl + (NN0 & 0xffffffu) * m;
            }
            {
                let bl = bcast(x1, owner, base) & 0xffffffu;    // next limb of the multiplier
                let T0 = bcast(t0, 0u, base);               // accumulator limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's accumulator limb 0 (0 for the last lane)
                let p = T0 + (X0 & 0xffffffu) * bl;            // lane 0's limb 0 after adding x*b
                let m = (p * ninv) & MASK;                 // Montgomery factor
                let carry0 = (p + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                // new t = old t shifted down one limb, plus x*b and n*m shifted the same way; each line reads the old value above it
                t0 = t1 + (x1 & 0xffffffu) * bl + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (x2 & 0xffffffu) * bl + (n2 & 0xffffffu) * m;
                t2 = t3 + (x3 & 0xffffffu) * bl + (n3 & 0xffffffu) * m;
                t3 = t4 + (x4 & 0xffffffu) * bl + (n4 & 0xffffffu) * m;
                t4 = t5 + (x5 & 0xffffffu) * bl + (n5 & 0xffffffu) * m;
                t5 = t6 + (x6 & 0xffffffu) * bl + (n6 & 0xffffffu) * m;
                t6 = t7 + (x7 & 0xffffffu) * bl + (n7 & 0xffffffu) * m;
                t7 = t8 + (x8 & 0xffffffu) * bl + (n8 & 0xffffffu) * m;
                t8 = t9 + (x9 & 0xffffffu) * bl + (n9 & 0xffffffu) * m;
                t9 = TN + (XN0 & 0xffffffu) * bl + (NN0 & 0xffffffu) * m;
            }
            {
                let bl = bcast(x2, owner, base) & 0xffffffu;    // next limb of the multiplier
                let T0 = bcast(t0, 0u, base);               // accumulator limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's accumulator limb 0 (0 for the last lane)
                let p = T0 + (X0 & 0xffffffu) * bl;            // lane 0's limb 0 after adding x*b
                let m = (p * ninv) & MASK;                 // Montgomery factor
                let carry0 = (p + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                // new t = old t shifted down one limb, plus x*b and n*m shifted the same way; each line reads the old value above it
                t0 = t1 + (x1 & 0xffffffu) * bl + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (x2 & 0xffffffu) * bl + (n2 & 0xffffffu) * m;
                t2 = t3 + (x3 & 0xffffffu) * bl + (n3 & 0xffffffu) * m;
                t3 = t4 + (x4 & 0xffffffu) * bl + (n4 & 0xffffffu) * m;
                t4 = t5 + (x5 & 0xffffffu) * bl + (n5 & 0xffffffu) * m;
                t5 = t6 + (x6 & 0xffffffu) * bl + (n6 & 0xffffffu) * m;
                t6 = t7 + (x7 & 0xffffffu) * bl + (n7 & 0xffffffu) * m;
                t7 = t8 + (x8 & 0xffffffu) * bl + (n8 & 0xffffffu) * m;
                t8 = t9 + (x9 & 0xffffffu) * bl + (n9 & 0xffffffu) * m;
                t9 = TN + (XN0 & 0xffffffu) * bl + (NN0 & 0xffffffu) * m;
            }
            {
                let bl = bcast(x3, owner, base) & 0xffffffu;    // next limb of the multiplier
                let T0 = bcast(t0, 0u, base);               // accumulator limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's accumulator limb 0 (0 for the last lane)
                let p = T0 + (X0 & 0xffffffu) * bl;            // lane 0's limb 0 after adding x*b
                let m = (p * ninv) & MASK;                 // Montgomery factor
                let carry0 = (p + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                // new t = old t shifted down one limb, plus x*b and n*m shifted the same way; each line reads the old value above it
                t0 = t1 + (x1 & 0xffffffu) * bl + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (x2 & 0xffffffu) * bl + (n2 & 0xffffffu) * m;
                t2 = t3 + (x3 & 0xffffffu) * bl + (n3 & 0xffffffu) * m;
                t3 = t4 + (x4 & 0xffffffu) * bl + (n4 & 0xffffffu) * m;
                t4 = t5 + (x5 & 0xffffffu) * bl + (n5 & 0xffffffu) * m;
                t5 = t6 + (x6 & 0xffffffu) * bl + (n6 & 0xffffffu) * m;
                t6 = t7 + (x7 & 0xffffffu) * bl + (n7 & 0xffffffu) * m;
                t7 = t8 + (x8 & 0xffffffu) * bl + (n8 & 0xffffffu) * m;
                t8 = t9 + (x9 & 0xffffffu) * bl + (n9 & 0xffffffu) * m;
                t9 = TN + (XN0 & 0xffffffu) * bl + (NN0 & 0xffffffu) * m;
            }
            {
                let bl = bcast(x4, owner, base) & 0xffffffu;    // next limb of the multiplier
                let T0 = bcast(t0, 0u, base);               // accumulator limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's accumulator limb 0 (0 for the last lane)
                let p = T0 + (X0 & 0xffffffu) * bl;            // lane 0's limb 0 after adding x*b
                let m = (p * ninv) & MASK;                 // Montgomery factor
                let carry0 = (p + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                // new t = old t shifted down one limb, plus x*b and n*m shifted the same way; each line reads the old value above it
                t0 = t1 + (x1 & 0xffffffu) * bl + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (x2 & 0xffffffu) * bl + (n2 & 0xffffffu) * m;
                t2 = t3 + (x3 & 0xffffffu) * bl + (n3 & 0xffffffu) * m;
                t3 = t4 + (x4 & 0xffffffu) * bl + (n4 & 0xffffffu) * m;
                t4 = t5 + (x5 & 0xffffffu) * bl + (n5 & 0xffffffu) * m;
                t5 = t6 + (x6 & 0xffffffu) * bl + (n6 & 0xffffffu) * m;
                t6 = t7 + (x7 & 0xffffffu) * bl + (n7 & 0xffffffu) * m;
                t7 = t8 + (x8 & 0xffffffu) * bl + (n8 & 0xffffffu) * m;
                t8 = t9 + (x9 & 0xffffffu) * bl + (n9 & 0xffffffu) * m;
                t9 = TN + (XN0 & 0xffffffu) * bl + (NN0 & 0xffffffu) * m;
            }
            {
                let bl = bcast(x5, owner, base) & 0xffffffu;    // next limb of the multiplier
                let T0 = bcast(t0, 0u, base);               // accumulator limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's accumulator limb 0 (0 for the last lane)
                let p = T0 + (X0 & 0xffffffu) * bl;            // lane 0's limb 0 after adding x*b
                let m = (p * ninv) & MASK;                 // Montgomery factor
                let carry0 = (p + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                // new t = old t shifted down one limb, plus x*b and n*m shifted the same way; each line reads the old value above it
                t0 = t1 + (x1 & 0xffffffu) * bl + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (x2 & 0xffffffu) * bl + (n2 & 0xffffffu) * m;
                t2 = t3 + (x3 & 0xffffffu) * bl + (n3 & 0xffffffu) * m;
                t3 = t4 + (x4 & 0xffffffu) * bl + (n4 & 0xffffffu) * m;
                t4 = t5 + (x5 & 0xffffffu) * bl + (n5 & 0xffffffu) * m;
                t5 = t6 + (x6 & 0xffffffu) * bl + (n6 & 0xffffffu) * m;
                t6 = t7 + (x7 & 0xffffffu) * bl + (n7 & 0xffffffu) * m;
                t7 = t8 + (x8 & 0xffffffu) * bl + (n8 & 0xffffffu) * m;
                t8 = t9 + (x9 & 0xffffffu) * bl + (n9 & 0xffffffu) * m;
                t9 = TN + (XN0 & 0xffffffu) * bl + (NN0 & 0xffffffu) * m;
            }
            {
                let bl = bcast(x6, owner, base) & 0xffffffu;    // next limb of the multiplier
                let T0 = bcast(t0, 0u, base);               // accumulator limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's accumulator limb 0 (0 for the last lane)
                let p = T0 + (X0 & 0xffffffu) * bl;            // lane 0's limb 0 after adding x*b
                let m = (p * ninv) & MASK;                 // Montgomery factor
                let carry0 = (p + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                // new t = old t shifted down one limb, plus x*b and n*m shifted the same way; each line reads the old value above it
                t0 = t1 + (x1 & 0xffffffu) * bl + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (x2 & 0xffffffu) * bl + (n2 & 0xffffffu) * m;
                t2 = t3 + (x3 & 0xffffffu) * bl + (n3 & 0xffffffu) * m;
                t3 = t4 + (x4 & 0xffffffu) * bl + (n4 & 0xffffffu) * m;
                t4 = t5 + (x5 & 0xffffffu) * bl + (n5 & 0xffffffu) * m;
                t5 = t6 + (x6 & 0xffffffu) * bl + (n6 & 0xffffffu) * m;
                t6 = t7 + (x7 & 0xffffffu) * bl + (n7 & 0xffffffu) * m;
                t7 = t8 + (x8 & 0xffffffu) * bl + (n8 & 0xffffffu) * m;
                t8 = t9 + (x9 & 0xffffffu) * bl + (n9 & 0xffffffu) * m;
                t9 = TN + (XN0 & 0xffffffu) * bl + (NN0 & 0xffffffu) * m;
            }
            {
                let bl = bcast(x7, owner, base) & 0xffffffu;    // next limb of the multiplier
                let T0 = bcast(t0, 0u, base);               // accumulator limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's accumulator limb 0 (0 for the last lane)
                let p = T0 + (X0 & 0xffffffu) * bl;            // lane 0's limb 0 after adding x*b
                let m = (p * ninv) & MASK;                 // Montgomery factor
                let carry0 = (p + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                // new t = old t shifted down one limb, plus x*b and n*m shifted the same way; each line reads the old value above it
                t0 = t1 + (x1 & 0xffffffu) * bl + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (x2 & 0xffffffu) * bl + (n2 & 0xffffffu) * m;
                t2 = t3 + (x3 & 0xffffffu) * bl + (n3 & 0xffffffu) * m;
                t3 = t4 + (x4 & 0xffffffu) * bl + (n4 & 0xffffffu) * m;
                t4 = t5 + (x5 & 0xffffffu) * bl + (n5 & 0xffffffu) * m;
                t5 = t6 + (x6 & 0xffffffu) * bl + (n6 & 0xffffffu) * m;
                t6 = t7 + (x7 & 0xffffffu) * bl + (n7 & 0xffffffu) * m;
                t7 = t8 + (x8 & 0xffffffu) * bl + (n8 & 0xffffffu) * m;
                t8 = t9 + (x9 & 0xffffffu) * bl + (n9 & 0xffffffu) * m;
                t9 = TN + (XN0 & 0xffffffu) * bl + (NN0 & 0xffffffu) * m;
            }
            {
                let bl = bcast(x8, owner, base) & 0xffffffu;    // next limb of the multiplier
                let T0 = bcast(t0, 0u, base);               // accumulator limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's accumulator limb 0 (0 for the last lane)
                let p = T0 + (X0 & 0xffffffu) * bl;            // lane 0's limb 0 after adding x*b
                let m = (p * ninv) & MASK;                 // Montgomery factor
                let carry0 = (p + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                // new t = old t shifted down one limb, plus x*b and n*m shifted the same way; each line reads the old value above it
                t0 = t1 + (x1 & 0xffffffu) * bl + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (x2 & 0xffffffu) * bl + (n2 & 0xffffffu) * m;
                t2 = t3 + (x3 & 0xffffffu) * bl + (n3 & 0xffffffu) * m;
                t3 = t4 + (x4 & 0xffffffu) * bl + (n4 & 0xffffffu) * m;
                t4 = t5 + (x5 & 0xffffffu) * bl + (n5 & 0xffffffu) * m;
                t5 = t6 + (x6 & 0xffffffu) * bl + (n6 & 0xffffffu) * m;
                t6 = t7 + (x7 & 0xffffffu) * bl + (n7 & 0xffffffu) * m;
                t7 = t8 + (x8 & 0xffffffu) * bl + (n8 & 0xffffffu) * m;
                t8 = t9 + (x9 & 0xffffffu) * bl + (n9 & 0xffffffu) * m;
                t9 = TN + (XN0 & 0xffffffu) * bl + (NN0 & 0xffffffu) * m;
            }
            {
                let bl = bcast(x9, owner, base) & 0xffffffu;    // next limb of the multiplier
                let T0 = bcast(t0, 0u, base);               // accumulator limb 0 of lane 0
                let TN = down1(t0, lane);                   // next lane's accumulator limb 0 (0 for the last lane)
                let p = T0 + (X0 & 0xffffffu) * bl;            // lane 0's limb 0 after adding x*b
                let m = (p * ninv) & MASK;                 // Montgomery factor
                let carry0 = (p + (N0 & 0xffffffu) * m) >> B;  // exact: the low 13 bits are zero
                // new t = old t shifted down one limb, plus x*b and n*m shifted the same way; each line reads the old value above it
                t0 = t1 + (x1 & 0xffffffu) * bl + (n1 & 0xffffffu) * m + (carry0 & is0);
                t1 = t2 + (x2 & 0xffffffu) * bl + (n2 & 0xffffffu) * m;
                t2 = t3 + (x3 & 0xffffffu) * bl + (n3 & 0xffffffu) * m;
                t3 = t4 + (x4 & 0xffffffu) * bl + (n4 & 0xffffffu) * m;
                t4 = t5 + (x5 & 0xffffffu) * bl + (n5 & 0xffffffu) * m;
                t5 = t6 + (x6 & 0xffffffu) * bl + (n6 & 0xffffffu) * m;
                t6 = t7 + (x7 & 0xffffffu) * bl + (n7 & 0xffffffu) * m;
                t7 = t8 + (x8 & 0xffffffu) * bl + (n8 & 0xffffffu) * m;
                t8 = t9 + (x9 & 0xffffffu) * bl + (n9 & 0xffffffu) * m;
                t9 = TN + (XN0 & 0xffffffu) * bl + (NN0 & 0xffffffu) * m;
            }
            if ((owner % K) == K - 1u) {
                {
                    var c_in = up1(t9 >> B, lane);   // read before any limb is modified
                    let v0 = t0;
                    t0 = (v0 & MASK) + c_in;
                    c_in = v0 >> B;
                    let v1 = t1;
                    t1 = (v1 & MASK) + c_in;
                    c_in = v1 >> B;
                    let v2 = t2;
                    t2 = (v2 & MASK) + c_in;
                    c_in = v2 >> B;
                    let v3 = t3;
                    t3 = (v3 & MASK) + c_in;
                    c_in = v3 >> B;
                    let v4 = t4;
                    t4 = (v4 & MASK) + c_in;
                    c_in = v4 >> B;
                    let v5 = t5;
                    t5 = (v5 & MASK) + c_in;
                    c_in = v5 >> B;
                    let v6 = t6;
                    t6 = (v6 & MASK) + c_in;
                    c_in = v6 >> B;
                    let v7 = t7;
                    t7 = (v7 & MASK) + c_in;
                    c_in = v7 >> B;
                    let v8 = t8;
                    t8 = (v8 & MASK) + c_in;
                    c_in = v8 >> B;
                    let v9 = t9;
                    t9 = (v9 & MASK) + c_in;
                    c_in = v9 >> B;
                }
            }
        }
        for (var round = 0u; round < L + 2u; round++) {
            let big = (t0 >> B) | (t1 >> B) | (t2 >> B) | (t3 >> B) | (t4 >> B) | (t5 >> B) | (t6 >> B) | (t7 >> B) | (t8 >> B) | (t9 >> B);
            if (!any_nonzero(big)) { break; }
            {
                var c_in = up1(t9 >> B, lane);   // read before any limb is modified
                let v0 = t0;
                t0 = (v0 & MASK) + c_in;
                c_in = v0 >> B;
                let v1 = t1;
                t1 = (v1 & MASK) + c_in;
                c_in = v1 >> B;
                let v2 = t2;
                t2 = (v2 & MASK) + c_in;
                c_in = v2 >> B;
                let v3 = t3;
                t3 = (v3 & MASK) + c_in;
                c_in = v3 >> B;
                let v4 = t4;
                t4 = (v4 & MASK) + c_in;
                c_in = v4 >> B;
                let v5 = t5;
                t5 = (v5 & MASK) + c_in;
                c_in = v5 >> B;
                let v6 = t6;
                t6 = (v6 & MASK) + c_in;
                c_in = v6 >> B;
                let v7 = t7;
                t7 = (v7 & MASK) + c_in;
                c_in = v7 >> B;
                let v8 = t8;
                t8 = (v8 & MASK) + c_in;
                c_in = v8 >> B;
                let v9 = t9;
                t9 = (v9 & MASK) + c_in;
                c_in = v9 >> B;
            }
        }
        x0 = t0;
        x1 = t1;
        x2 = t2;
        x3 = t3;
        x4 = t4;
        x5 = t5;
        x6 = t6;
        x7 = t7;
        x8 = t8;
        x9 = t9;
    }
    if (live) {
        x_limbs[off + 0u] = x0;
        x_limbs[off + 1u] = x1;
        x_limbs[off + 2u] = x2;
        x_limbs[off + 3u] = x3;
        x_limbs[off + 4u] = x4;
        x_limbs[off + 5u] = x5;
        x_limbs[off + 6u] = x6;
        x_limbs[off + 7u] = x7;
        x_limbs[off + 8u] = x8;
        x_limbs[off + 9u] = x9;
    }
}
